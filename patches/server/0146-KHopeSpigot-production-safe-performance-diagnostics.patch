+    public static void startDetailCapture(int seconds, boolean includeJobs) {
+        final int duration = clampCaptureSeconds(seconds);
+
+        skipCurrentTick = true;
+        ensureDetailBuffers();
+        clearDetailStats();
+
+        final long now = System.nanoTime();
+        detailEnabled = true;
+        jobsEnabled = includeJobs;
+        captureUntilNanos = now + duration * 1_000_000_000L;
+        detailWindowStartNanos = now;
+        detailWindowLastNanos = now;
+    }
+
+    public static void stopDetailCapture() {
+        skipCurrentTick = true;
+        detailEnabled = false;
+        jobsEnabled = false;
+        detailThisTick = false;
+        jobsThisTick = false;
+        captureUntilNanos = 0L;
+        detailWindowLastNanos = System.nanoTime();
+    }
+
+    public static int getRemainingCaptureSeconds() {
+        if (!detailEnabled) return 0;
+
+        final long remaining = captureUntilNanos - System.nanoTime();
+        if (remaining <= 0L) {
+            detailEnabled = false;
+            jobsEnabled = false;
+            return 0;
         }
+        return (int) Math.max(1L, remaining / 1_000_000_000L);
+    }
+
+    public static int getMaxCaptureSeconds() {
