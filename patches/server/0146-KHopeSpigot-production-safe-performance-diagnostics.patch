+    private int parsePerfDuration(CommandSender sender, String[] args, int defaultSeconds) {
+        if (args.length < 3) return defaultSeconds;
+
+        final int seconds;
+        try {
+            seconds = Integer.parseInt(args[2]);
+        } catch (NumberFormatException e) {
+            sender.sendMessage(ChatColor.RED + "Duree invalide : " + args[2]);
+            return -1;
+        }
+
+        if (seconds < 1
+                || seconds > com.hpfxd.pandaspigot.util.KhopePerformanceDiagnostics.getMaxCaptureSeconds()) {
+            sender.sendMessage(ChatColor.RED + "Duree attendue : 1-"
+                    + com.hpfxd.pandaspigot.util.KhopePerformanceDiagnostics.getMaxCaptureSeconds()
+                    + " secondes.");
+            return -1;
+        }
+        return seconds;
+    }
+
+    private void sendPerfUsage(CommandSender sender) {
+        sender.sendMessage(ChatColor.GOLD + "/khope perf [status|reset|mem|stop]");
+        sender.sendMessage(ChatColor.GOLD + "/khope perf detail [secondes] "
+                + ChatColor.GRAY + "- sous-systemes temporairement");
+        sender.sendMessage(ChatColor.GOLD + "/khope perf jobs [secondes] "
+                + ChatColor.GRAY + "- sous-systemes + FutureTask temporairement");
+    }
