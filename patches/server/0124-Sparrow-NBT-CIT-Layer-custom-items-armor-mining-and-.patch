@@ -0,0 +1,46 @@
+package com.hpfxd.pandaspigot.util;
+
+import net.minecraft.server.ItemStack;
+import net.minecraft.server.NBTTagCompound;
+
+/**
+ * Central utility for reading the custom item identity via the NBT tag sparrowmc-item.
+ * Single entry point for all future NMS patches that need this read.
+ *
+ * NBT contract:
+ *   - key  : sparrowmc-item
+ *   - type : String (NBT type 8)
+ *   - location : root compound of the ItemStack (item.getTag())
+ *   - source of truth : PluginCIT (me.krunsh.customcit.CustomCIT)
+ */
+public final class SparrowItem {
+
+    public static final String CUSTOM_ID_KEY = "sparrowmc-item";
+
+    private SparrowItem() {}
+
+    /**
+     * Returns the custom id of the item, or null if the item is null, has no NBT tag,
+     * the key is missing, or the value is empty.
+     * No normalization is applied — the id is returned exactly as stored in NBT.
+     * Never throws.
+     */
+    public static String getCustomId(ItemStack item) {
+        if (item == null || !item.hasTag()) {
+            return null;
+        }
+        NBTTagCompound tag = item.getTag();
+        if (!tag.hasKeyOfType(CUSTOM_ID_KEY, 8)) {
+            return null;
+        }
+        String id = tag.getString(CUSTOM_ID_KEY);
+        return id.isEmpty() ? null : id;
+    }
+
+    /**
+     * Returns true if the item carries a non-blank custom id.
+     */
+    public static boolean hasCustomId(ItemStack item) {
+        return getCustomId(item) != null;
+    }
+}
