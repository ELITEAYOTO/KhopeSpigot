--- /dev/null
+++ b/src/main/java/com/hpfxd/pandaspigot/util/SparrowArmorRegistry.java
@@ -0,0 +1,79 @@
+package com.hpfxd.pandaspigot.util;
+
+import com.hpfxd.pandaspigot.config.SparrowArmorConfig;
+import net.minecraft.server.ItemStack;
+
+import java.util.Map;
+
+/**
+ * Lookup helper for custom armor protection bonuses (sparrowmc-item NBT key).
+ *
+ * Values are read at call time from PandaSpigotConfig.customArmorProtection.
+ * Returns 0 for null ids, unknown ids, or uninitialised config — vanilla behavior preserved.
+ *
+ * Applied in EntityLiving.applyArmorModifier() as an additive bonus on top of the
+ * vanilla ItemArmor.c sum returned by EntityLiving.br().
+ *
+ * Scale: same as vanilla armor points (ItemArmor.c field).
+ *   Typical per-piece values: 1 (boots/helmet leather) to 8 (chestplate diamond).
+ *   Total vanilla cap: 20 (full diamond). Custom bonus adds on top — formula clamps to 0.
+ *
+ * Scope: armor slots only — the hand slot is never included.
+ *   EntityHuman   : getEquipment() returns inventory.armor[0..3] directly, no hand slot.
+ *   All other entities: getEquipment(int i) with i in [1..4] is used explicitly;
+ *     index 0 (the hand slot for EntityInsentient) is always skipped.
+ * This slice does NOT touch armor durability — that is a separate domain (PlayerInventory.a).
+ * It does NOT modify enchantment-based protection (applyMagicModifier) or absorption.
+ */
+public final class SparrowArmorRegistry {
+
+    private SparrowArmorRegistry() {}
+
+    /**
+     * Returns the additive protection bonus (in vanilla armor points) for the given
+     * custom armor piece id. Returns 0 if the id is null, unknown, or the config is empty.
+     */
+    public static int getProtectionBonus(String sparrowId) {
+        if (sparrowId == null) { return 0; }
+        SparrowArmorConfig cfg = SparrowArmorConfig.get();
+        if (cfg == null) { return 0; }
+        Map<String, Integer> bonuses = cfg.customArmorProtection;
+        if (bonuses == null) { return 0; }
+        Integer bonus = bonuses.get(sparrowId);
+        return bonus != null ? bonus : 0;
+    }
+
+    /**
+     * Returns the total custom protection bonus for all armor slots of the given entity.
+     *
+     * Slot mapping (hand slot is never included):
+     *   EntityHuman: getEquipment() returns inventory.armor[0..3] — all 4 entries are armor
+     *     slots (boots, leggings, chestplate, helmet). Iterated via the full array.
+     *
+     *   All other EntityLiving: getEquipment(int i) is used with i in [1..4].
+     *     For EntityInsentient, equipment[0] is the hand slot (bA()) — it is skipped.
+     *     For any other subclass, slots 1..4 are conservatively read (no assumptions).
+     *
+     * Slots with null or unknown sparrowmc-item ids contribute 0 — vanilla preserved.
+     */
+    public static int getTotalBonus(net.minecraft.server.EntityLiving entity) {
+        if (entity instanceof net.minecraft.server.EntityHuman) {
+            // EntityHuman.getEquipment() returns inventory.armor only — no hand slot.
+            ItemStack[] equipment = entity.getEquipment();
+            if (equipment == null) { return 0; }
+            int total = 0;
+            for (ItemStack slot : equipment) {
+                total += getProtectionBonus(SparrowItem.getCustomId(slot));
+            }
+            return total;
+        } else {
+            // EntityInsentient (and any other EntityLiving): equipment[0] is the hand slot.
+            // Read only indices 1..4 (armor slots) via getEquipment(int).
+            int total = 0;
+            for (int i = 1; i <= 4; i++) {
+                total += getProtectionBonus(SparrowItem.getCustomId(entity.getEquipment(i)));
+            }
+            return total;
+        }
+    }
+}
