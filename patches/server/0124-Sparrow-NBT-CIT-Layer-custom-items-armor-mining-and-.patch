+import java.util.Map;
+
+/**
+ * Lookup helper for custom armor piece durability multipliers (sparrowmc-item NBT key).
+ *
+ * Values are read at call time from PandaSpigotConfig.customArmorDurabilityMultiplier.
+ * Returns 1.0 for null ids, unknown ids, or uninitialised config — vanilla behavior preserved.
+ *
+ * Applied in PlayerInventory.a(float) — the single point where all 4 player armor slots
+ * lose durability after taking damage. Mobs (EntityInsentient) have a no-op damageArmor()
+ * and are not affected.
+ *
+ * Multiplier semantics — applied to the vanilla per-piece durability cost (vanillaDamage = (int)(rawDamage/4),
+ * min 1), NOT to the raw float before the cast:
+ *   1.0 = vanilla behavior (damage = vanillaDamage, exact match)
+ *   0.5 = 50% probabilistic skip per call — armor lasts ~2x longer
+ *   0.0 = indestructible (all durability loss is skipped)
+ *   2.0 = damage = Math.max(1, round(vanillaDamage * 2.0)) — armor wears twice as fast
+ *
+ * For multipliers < 1.0, the probabilistic skip fires BEFORE ItemStack.damage():
+ *   - Unbreaking enchant (inside isDamaged) stacks multiplicatively if present.
+ *   - PlayerItemDamageEvent is NOT fired for skipped calls.
+ * Both behaviours are intentional and assumed for this phase.
+ *
+ * Scope: armor durability only. Protection (armor points) is handled in
+ * EntityLiving.applyArmorModifier() via SparrowArmorRegistry.
+ */
+public final class SparrowArmorDurabilityRegistry {
+
+    private SparrowArmorDurabilityRegistry() {}
+
+    /**
+     * Returns the durability multiplier for the given custom armor piece id.
+     * Returns 1.0f if the id is null, unknown, or the config section is empty — vanilla preserved.
+     */
+    public static float getDurabilityMultiplier(String sparrowId) {
+        if (sparrowId == null) { return 1.0f; }
+        SparrowArmorConfig cfg = SparrowArmorConfig.get();
+        if (cfg == null) { return 1.0f; }
+        Map<String, Double> multipliers = cfg.customArmorDurabilityMultiplier;
+        if (multipliers == null) { return 1.0f; }
+        Double m = multipliers.get(sparrowId);
+        return m != null ? m.floatValue() : 1.0f;
+    }
+}
diff --git a/src/main/java/com/hpfxd/pandaspigot/util/SparrowArmorRegistry.java b/src/main/java/com/hpfxd/pandaspigot/util/SparrowArmorRegistry.java
