+++ b/src/main/java/com/hpfxd/pandaspigot/util/SparrowArmorSetRegistry.java
@@ -0,0 +1,109 @@
+package com.hpfxd.pandaspigot.util;
+
+import com.hpfxd.pandaspigot.config.SparrowArmorConfig;
+import net.minecraft.server.EntityHuman;
+import net.minecraft.server.ItemStack;
+
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Optional detection helper for custom armor families (sparrowmc-item NBT key).
+ *
+ * A set is "complete" when all piece ids listed in the config for that set name are
+ * present across the player's 4 armor slots (helmet, chestplate, leggings, boots).
+ *
+ * Set definitions are read from SparrowArmorConfig.customArmorSets:
+ *   customArmorSets:
+ *     azurite: [azurite_helmet, azurite_chestplate, azurite_leggings, azurite_boots]
+ *
+ * Detection relies exclusively on the sparrowmc-item tag, which is written at item
+ * creation time (/givecit) and is always present on valid CIT pieces.
+ * The secondary <set>_armor tag written by PluginCIT is intentionally NOT used here:
+ * it is applied lazily on equip events and may be absent after server restart or login.
+ *
+ * Scope: detection only. No effect, bonus, or gameplay config is applied here.
+ * Base armor gameplay remains piece-by-piece: protection and durability are configured
+ * directly on each armor item id, with no implicit full-set bonus.
+ * This helper exists only for explicit future features that may want to query whether
+ * a complete named family is worn.
+ *
+ * Slot source: EntityHuman.getEquipment() returns inventory.armor[0..3] directly —
+ * no hand slot is included. Same contract as SparrowArmorRegistry.getTotalBonus().
+ *
+ * Edge cases:
+ *   - Empty armor slot: SparrowItem.getCustomId(null) = null, not counted.
+ *   - Piece without sparrowmc-item tag: getCustomId returns null, not counted.
+ *   - A sparrowmc-item id can only belong to one set at a time (String is unique per item).
+ *   - Unknown set name (not in config): hasFullArmorSet returns false.
+ *   - Empty config section: both methods return false/empty.
+ *
+ * Evaluation cost: O(4 + 4 * |sets|) per call. Not invoked on a tick loop in this slice;
+ * callers are responsible for limiting invocation frequency.
+ */
+public final class SparrowArmorSetRegistry {
+
+    private SparrowArmorSetRegistry() {}
+
+    /**
+    * Returns true if the player is wearing all pieces of the named family.
+    * The family must be defined in customArmorSets config with exactly the ids worn.
+     * Returns false if the set is unknown, the config is empty, or any piece is missing.
+     */
+    public static boolean hasFullArmorSet(EntityHuman player, String setName) {
+        if (setName == null || setName.isEmpty()) { return false; }
+        SparrowArmorConfig cfg = SparrowArmorConfig.get();
+        if (cfg == null) { return false; }
+        Map<String, List<String>> sets = cfg.customArmorSets;
+        if (sets == null) { return false; }
+        List<String> required = sets.get(setName);
+        if (required == null || required.isEmpty()) { return false; }
+
+        ItemStack[] armor = player.getEquipment();
+        if (armor == null) { return false; }
+
+        // Collect sparrowmc-item ids worn across all armor slots.
+        Set<String> worn = new HashSet<>();
+        for (ItemStack slot : armor) {
+            String id = SparrowItem.getCustomId(slot);
+            if (id != null) { worn.add(id); }
+        }
+
+        return worn.containsAll(required);
+    }
+
+    /**
+    * Returns the names of all fully-equipped armor families for the given player.
+    * Returns an empty set when no family is complete or the config section is empty.
+     * Iteration order follows the insertion order of customArmorSets in the config.
+     */
+    public static Set<String> getActiveArmorSets(EntityHuman player) {
+        SparrowArmorConfig cfg = SparrowArmorConfig.get();
+        if (cfg == null) { return Collections.emptySet(); }
+        Map<String, List<String>> sets = cfg.customArmorSets;
+        if (sets == null || sets.isEmpty()) { return Collections.emptySet(); }
+
+        ItemStack[] armor = player.getEquipment();
+        if (armor == null) { return Collections.emptySet(); }
+
+        // Collect worn ids once, then check each set — O(4 + 4*|sets|).
+        Set<String> worn = new HashSet<>();
+        for (ItemStack slot : armor) {
+            String id = SparrowItem.getCustomId(slot);
+            if (id != null) { worn.add(id); }
+        }
+
+        Set<String> active = new LinkedHashSet<>();
+        for (Map.Entry<String, List<String>> entry : sets.entrySet()) {
+            List<String> required = entry.getValue();
+            if (required != null && !required.isEmpty() && worn.containsAll(required)) {
+                active.add(entry.getKey());
+            }
+        }
+        return active;
+    }
+}
