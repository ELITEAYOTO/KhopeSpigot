index 0000000000000000000000000000000000000000..d02b540f631a9b84c5b1099fcb68325945aa316b
--- /dev/null
+++ b/src/main/java/com/hpfxd/pandaspigot/config/SparrowArmorConfig.java
@@ -0,0 +1,166 @@
+package com.hpfxd.pandaspigot.config;
+
+import java.io.File;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.logging.Logger;
+import java.util.regex.Pattern;
+
+import org.spongepowered.configurate.CommentedConfigurationNode;
+import org.spongepowered.configurate.objectmapping.ConfigSerializable;
+import org.spongepowered.configurate.objectmapping.ObjectMapper;
+import org.spongepowered.configurate.objectmapping.meta.Comment;
+import org.spongepowered.configurate.util.MapFactories;
+import org.spongepowered.configurate.util.NamingSchemes;
+
+import com.google.common.base.Throwables;
+import com.hpfxd.configurate.eoyaml.EOYamlConfigurationLoader;
+
+/**
+ * SparrowMC armor configuration — loaded from sparrow-armor.yml.
+ *
+ * Covers per-piece protection and durability for custom armor keyed by sparrowmc-item NBT tag,
+ * and optional family definitions for set detection.
+ *
+ * Armor is ALWAYS configured per piece. No automatic full-set bonus is applied from this file.
+ * A chestplate must always provide more protection than leggings, and leggings more than boots/helmet.
+ *
+ * All ids must be lowercase ASCII. Any non-conforming id is logged as a warning at load time.
+ */
+@ConfigSerializable
+@SuppressWarnings({"FieldCanBeLocal", "FieldMayBeFinal"})
+public class SparrowArmorConfig {
+
+    private static final Pattern VALID_ID = Pattern.compile("[a-z0-9_\\-]+");
+    private static final Logger LOGGER = Logger.getLogger("Minecraft");
+
+    private static SparrowArmorConfig config;
+
+    public static void init(File file) {
+        EOYamlConfigurationLoader loader = EOYamlConfigurationLoader.builder()
+                .file(file)
+                .defaultOptions(o -> o
+                        .header("SparrowMC armor configuration.\n" +
+                                "Per-piece protection and durability for custom armor (sparrowmc-item NBT tag).\n" +
+                                "\n" +
+                                "Core rule — armor is always per piece, never a set bonus:\n" +
+                                "  - chestplate > leggings > helmet/boots (vanilla-like hierarchy)\n" +
+                                "  - No automatic bonus is applied when a full set is worn\n" +
+                                "  - customArmorSets is for optional detection only, not for gameplay effects\n" +
+                                "\n" +
+                                "Protection scale (vanilla armor points):\n" +
+                                "  Vanilla diamond full set = 20 points total\n" +
+                                "  Typical per-piece: 3 (boots) / 8 (chestplate) / 6 (leggings) / 3 (helmet)\n" +
+                                "  Custom bonus is additive on top of the vanilla ItemArmor base value.\n" +
+                                "\n" +
+                                "Durability scale:\n" +
+                                "  1.0 = vanilla wear, 0.5 = lasts ~2x longer, 0.0 = indestructible\n" +
+                                "\n" +
+                                "Rules:\n" +
+                                "  - All ids must be lowercase ASCII: letters a-z, digits 0-9, underscores, hyphens.\n" +
+                                "  - Ids must match exactly the sparrowmc-item tag and the CIT pack.\n" +
+                                "  - Non-conforming ids are logged as warnings at startup and on reload.\n" +
+                                "  - Leave a section empty to preserve vanilla behavior on all pieces.")
+                        .mapFactory(MapFactories.insertionOrdered())
+                        .serializers(build -> build.registerAnnotatedObjects(ObjectMapper.factoryBuilder()
+                                .defaultNamingScheme(NamingSchemes.CAMEL_CASE)
+                                .build())))
+                .build();
+
+        try {
+            CommentedConfigurationNode root = loader.load();
+            config = root.get(SparrowArmorConfig.class);
+            root.set(config);
+            loader.save(root);
+            validateIds(config);
+        } catch (Exception e) {
+            throw Throwables.propagate(e);
+        }
+    }
+
+    private static void validateIds(SparrowArmorConfig cfg) {
+        if (cfg.customArmorProtection != null) {
+            for (String id : cfg.customArmorProtection.keySet()) {
+                if (!VALID_ID.matcher(id).matches()) {
+                    LOGGER.warning("[Sparrow] sparrow-armor.yml: invalid id '" + id
+                            + "' in customArmorProtection — ids must match [a-z0-9_\\-]+");
+                }
+            }
+        }
+        if (cfg.customArmorDurabilityMultiplier != null) {
+            for (String id : cfg.customArmorDurabilityMultiplier.keySet()) {
+                if (!VALID_ID.matcher(id).matches()) {
+                    LOGGER.warning("[Sparrow] sparrow-armor.yml: invalid id '" + id
+                            + "' in customArmorDurabilityMultiplier — ids must match [a-z0-9_\\-]+");
+                }
+            }
+        }
+        if (cfg.customArmorSets != null) {
+            for (Map.Entry<String, List<String>> entry : cfg.customArmorSets.entrySet()) {
+                String setName = entry.getKey();
+                if (!VALID_ID.matcher(setName).matches()) {
+                    LOGGER.warning("[Sparrow] sparrow-armor.yml: invalid set name '" + setName
+                            + "' in customArmorSets — names must match [a-z0-9_\\-]+");
+                }
+                if (entry.getValue() != null) {
+                    for (String pieceId : entry.getValue()) {
+                        if (!VALID_ID.matcher(pieceId).matches()) {
+                            LOGGER.warning("[Sparrow] sparrow-armor.yml: invalid piece id '" + pieceId
+                                    + "' in customArmorSets." + setName + " — ids must match [a-z0-9_\\-]+");
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    public static SparrowArmorConfig get() {
+        return config;
+    }
+
+    // ----------------------------------------------------------------------------
+
+    @Comment("Additive protection bonuses for custom armor pieces (sparrowmc-item NBT tag).\n" +
+            "Each key is a sparrowmc-item id, each value is the bonus in vanilla armor points.\n" +
+            "Vanilla scale: 1-3 per helmet or boots, 5-8 per chestplate. Full vanilla diamond = 20 points.\n" +
+            "The bonus is additive on top of the vanilla ItemArmor base value.\n" +
+            "Keep the chestplate higher than leggings, and leggings higher than helmet and boots.\n" +
+            "Leave empty to preserve vanilla protection on all pieces.\n" +
+            "Example:\n" +
+            "  customArmorProtection:\n" +
+            "    azurite_helmet: 4\n" +
+            "    azurite_chestplate: 9\n" +
+            "    azurite_leggings: 7\n" +
+            "    azurite_boots: 4")
+    public Map<String, Integer> customArmorProtection = new HashMap<>();
+
+    @Comment("Durability cost multipliers for custom armor pieces (sparrowmc-item NBT tag).\n" +
+            "Applied in PlayerInventory.a(float) — the point where all 4 armor slots lose durability after damage.\n" +
+            "  1.0 = vanilla behavior\n" +
+            "  0.5 = armor lasts ~2x longer (50%% probabilistic skip per damage call)\n" +
+            "  0.0 = indestructible (all durability loss is skipped)\n" +
+            "  2.0 = armor wears twice as fast\n" +
+            "Probabilistic skip for values below 1.0: Unbreaking and PlayerItemDamageEvent are\n" +
+            "not triggered for skipped durability calls.\n" +
+            "Leave empty to preserve vanilla durability on all armor pieces.\n" +
+            "Example:\n" +
+            "  customArmorDurabilityMultiplier:\n" +
+            "    azurite_helmet: 0.85\n" +
+            "    azurite_chestplate: 0.80\n" +
+            "    azurite_leggings: 0.82\n" +
+            "    azurite_boots: 0.88")
+    public Map<String, Double> customArmorDurabilityMultiplier = new HashMap<>();
+
+    @Comment("Optional armor family definitions for explicit set detection only.\n" +
+            "This section does NOT affect base armor balance. Protection and durability remain\n" +
+            "configured per piece above. No automatic set bonus is applied from this section.\n" +
+            "Each key is a family name; value is the list of sparrowmc-item ids forming a complete set.\n" +
+            "Detection uses sparrowmc-item only — the secondary <set>_armor tag written by PluginCIT\n" +
+            "is intentionally ignored (it may be absent after a server restart).\n" +
+            "Leave empty if no explicit family-detection feature is needed.\n" +
+            "Example:\n" +
+            "  customArmorSets:\n" +
+            "    azurite: [azurite_helmet, azurite_chestplate, azurite_leggings, azurite_boots]")
+    public Map<String, List<String>> customArmorSets = new HashMap<>();
+}
