+            }
+        }
+    }
+
+    public static SparrowItemsConfig get() {
+        return config;
+    }
+
+    // ----------------------------------------------------------------------------
+
+    @Comment("Durability cost multipliers for custom non-armor items (sparrowmc-item NBT tag).\n" +
+            "Scope: tools, swords, bows, shears, flint-and-steel, fishing rod, carrot-on-a-stick.\n" +
+            "Armor durability is configured separately in sparrow-armor.yml.\n" +
+            "  1.0 = vanilla behavior\n" +
+            "  0.5 = item lasts ~2x longer (50%% probabilistic skip per durability event)\n" +
+            "  0.0 = indestructible\n" +
+            "  2.0 = item wears twice as fast\n" +
+            "Probabilistic skip for values below 1.0: Unbreaking and PlayerItemDamageEvent are\n" +
+            "not triggered for skipped durability calls.\n" +
+            "Leave empty to preserve vanilla durability on all items.\n" +
+            "Example:\n" +
+            "  customItemDurabilityMultiplier:\n" +
+            "    topaze_sword: 0.90\n" +
+            "    jaspe_sword: 0.85\n" +
+            "    saphir_sword: 0.80\n" +
+            "    pioche_topaze: 0.70\n" +
+            "    pioche_azurite: 0.60")
+    public Map<String, Double> customItemDurabilityMultiplier = new HashMap<>();
+}
