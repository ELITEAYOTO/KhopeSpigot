+import com.hpfxd.configurate.eoyaml.EOYamlConfigurationLoader;
+
+/**
+ * SparrowMC items configuration — loaded from sparrow-items.yml.
+ *
+ * Covers: durability multipliers for custom non-armor items keyed by sparrowmc-item NBT tag.
+ * Scope: tools (pickaxe, axe, shovel, hoe), swords, bows, shears, flint-and-steel,
+ *        fishing rod, carrot-on-a-stick.
+ * Armor durability is configured separately in sparrow-armor.yml.
+ *
+ * All ids must be lowercase ASCII. Any non-conforming id is logged as a warning at load time.
+ */
+@ConfigSerializable
+@SuppressWarnings({"FieldCanBeLocal", "FieldMayBeFinal"})
+public class SparrowItemsConfig {
+
+    private static final Pattern VALID_ID = Pattern.compile("[a-z0-9_\\-]+");
+    private static final Logger LOGGER = Logger.getLogger("Minecraft");
+
+    private static SparrowItemsConfig config;
+
+    public static void init(File file) {
+        EOYamlConfigurationLoader loader = EOYamlConfigurationLoader.builder()
+                .file(file)
+                .defaultOptions(o -> o
+                        .header("SparrowMC items configuration.\n" +
+                                "Durability multipliers for custom non-armor items (sparrowmc-item NBT tag).\n" +
+                                "\n" +
+                                "Scope: tools (pickaxe, axe, shovel, hoe), swords, bows, shears,\n" +
+                                "flint-and-steel, fishing rod, carrot-on-a-stick.\n" +
+                                "Armor durability is configured separately in sparrow-armor.yml.\n" +
+                                "\n" +
+                                "Multiplier scale:\n" +
+                                "  1.0 = vanilla behavior (no change)\n" +
+                                "  0.5 = item lasts ~2x longer (50%% probabilistic skip per use)\n" +
+                                "  0.0 = indestructible (all durability damage is skipped)\n" +
+                                "  2.0 = item wears twice as fast\n" +
+                                "\n" +
+                                "Rules:\n" +
+                                "  - All ids must be lowercase ASCII: letters a-z, digits 0-9, underscores, hyphens.\n" +
+                                "  - Ids must match exactly the sparrowmc-item tag written by your plugin and the CIT pack.\n" +
+                                "  - If the id in config, NBT, and CIT pack do not match exactly, the item is treated\n" +
+                                "    as vanilla — no multiplier is applied and no error is thrown at runtime.\n" +
+                                "  - Non-conforming ids detected at load time are logged as warnings.\n" +
+                                "  - Leave a section empty to preserve vanilla behavior on all items.")
+                        .mapFactory(MapFactories.insertionOrdered())
+                        .serializers(build -> build.registerAnnotatedObjects(ObjectMapper.factoryBuilder()
+                                .defaultNamingScheme(NamingSchemes.CAMEL_CASE)
+                                .build())))
