--- a/src/main/java/com/hpfxd/pandaspigot/util/SparrowMiningRegistry.java
+++ b/src/main/java/com/hpfxd/pandaspigot/util/SparrowMiningRegistry.java
@@ -1,98 +1,163 @@
 package com.hpfxd.pandaspigot.util;
 
+import java.util.Set;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+
+import org.bukkit.Material;
+import org.bukkit.craftbukkit.util.CraftMagicNumbers;
+
 import com.hpfxd.pandaspigot.config.SparrowMiningConfig;
+import com.hpfxd.pandaspigot.config.SparrowMiningConfig.BlockOverride;
+import com.hpfxd.pandaspigot.config.SparrowMiningConfig.MiningProfile;
+
+import net.minecraft.server.Block;
+import net.minecraft.server.ItemStack;
 
 /**
- * Lookup helpers for custom mining speed — V2 profile-based (tick-aware) with V1 legacy fallback.
+ * Helpers de minage V7 - formule additive partagee.
  *
- * V2 path: customMiningProfiles — MiningProfile with bonusPermille, maxStoneTickGain, earlyBreakMode.
- *          The motor applies a stone-class guard (Material.STONE) via resolveEffectiveMult().
- * V1 path: customMiningSpeedMultiplier — raw float multiplier, no stone guard, backward compat.
+ * f = toolMaterialSpeed(8.0) + rarityBonus + efficiencyBoosts[level]
+ * Haste : vanilla ou nerfed_no_oneshot avec clamp anti-instamine.
  *
- * null / unknown id / bonusPermille <= 0 → returns null profile → vanilla preserved exactly.
+ * Aucun item sans NBT sparrowmc-item configure ne traverse ces helpers : la route vanilla est intacte.
  */
 public final class SparrowMiningRegistry {
 
+    private static final Set<UUID> debugPlayers = ConcurrentHashMap.newKeySet();
+
     private SparrowMiningRegistry() {}
 
+    // ---------- profils ----------
+
+    public static MiningProfile getProfile(String sparrowId) {
+        if (sparrowId == null) return null;
+        SparrowMiningConfig cfg = SparrowMiningConfig.get();
+        if (cfg == null || cfg.customMiningProfiles == null) return null;
+        return cfg.customMiningProfiles.get(sparrowId);
+    }
+
+    public static MiningProfile getProfile(ItemStack item) {
+        return getProfile(SparrowItem.getCustomId(item));
+    }
+
+    public static boolean isCustomTool(ItemStack item) {
+        return getProfile(item) != null;
+    }
+
+    public static float getRarityBonus(ItemStack item) {
+        MiningProfile p = getProfile(item);
+        return p == null ? 0.0f : p.rarityBonus;
+    }
+
+    public static boolean isEarlyBreakAllowed(MiningProfile profile) {
+        return profile != null && !"never".equals(profile.earlyBreakMode);
+    }
+
+    // ---------- formule additive ----------
+
     /**
-     * Returns the V2 profile for the given id, or a synthetic profile wrapping a V1 entry.
-     * Returns null when the id is not configured or the configured value is vanilla (bonusPermille <= 0).
-     * null → no speed change, vanilla behavior preserved.
+     * Applique la table Efficiency partagee de maniere ADDITIVE.
+     * Si le niveau est absent ou 0, retourne base inchangee.
      */
-    public static SparrowMiningConfig.MiningProfile getProfile(String sparrowId) {
-        if (sparrowId == null) return null;
+    public static float applyCustomEfficiency(float base, int level) {
+        if (level <= 0) return base;
         SparrowMiningConfig cfg = SparrowMiningConfig.get();
-        if (cfg == null) return null;
+        if (cfg == null || cfg.efficiency == null || cfg.efficiency.efficiencyBoosts == null) return base;
+        Float boost = cfg.efficiency.efficiencyBoosts.get(level);
+        if (boost == null) return base;
+        return base + boost.floatValue();
+    }
 
-        // V2 first — explicit profile takes precedence
-        if (cfg.customMiningProfiles != null) {
-            SparrowMiningConfig.MiningProfile p = cfg.customMiningProfiles.get(sparrowId);
-            if (p != null && p.bonusPermille > 0) return p;
+    /**
+     * Applique la politique Haste configuree.
+     */
+    public static float applyCustomHaste(float speed, int hasteLevel) {
+        if (hasteLevel <= 0) return speed;
+        SparrowMiningConfig cfg = SparrowMiningConfig.get();
+        if (cfg == null || cfg.haste == null) {
+            return speed * (1.0f + hasteLevel * 0.2f);
         }
-
-        // V1 legacy fallback — wrap as synthetic profile, no stone guard
-        if (cfg.customMiningSpeedMultiplier != null) {
-            Double m = cfg.customMiningSpeedMultiplier.get(sparrowId);
-            if (m != null && m > 1.0) {
-                SparrowMiningConfig.MiningProfile synthetic = new SparrowMiningConfig.MiningProfile();
-                synthetic.bonusPermille = (int) Math.round((m - 1.0) * 1000.0);
-                synthetic.maxStoneTickGain = -1; // sentinel: no stone guard for legacy entries
-                synthetic.earlyBreakMode = "auto";
-                return synthetic;
-            }
+        if ("vanilla".equalsIgnoreCase(cfg.haste.mode)) {
+            return speed * (1.0f + hasteLevel * 0.2f);
         }
+        // nerfed_no_oneshot
+        Float mult = cfg.haste.nerfedMultipliers != null ? cfg.haste.nerfedMultipliers.get(hasteLevel) : null;
+        if (mult == null) return speed;
+        return speed * mult.floatValue();
+    }
+
+    // ---------- durete ----------
 
-        return null;
+    /**
+     * Retourne la durete custom configuree pour le bloc, ou 0 si absente (preserve vanilla).
+     */
+    public static float getCustomHardness(Block block) {
+        if (block == null) return 0.0f;
+        SparrowMiningConfig cfg = SparrowMiningConfig.get();
+        if (cfg == null || cfg.blockHardnessOverrides == null || cfg.blockHardnessOverrides.isEmpty()) {
+            return 0.0f;
+        }
+        Material mat;
+        try {
+            mat = CraftMagicNumbers.getMaterial(block);
+        } catch (Throwable t) {
+            return 0.0f;
+        }
+        if (mat == null) return 0.0f;
+        Float v = cfg.blockHardnessOverrides.get(mat.name());
+        return v == null ? 0.0f : v.floatValue();
     }
 
+    // ---------- ticks par session ----------
+
     /**
-     * Resolves the effective multiplier for a profile, applying the maxStoneTickGain guard
-     * when the block is stone-class (Material.STONE).
-     *
-     * Stone guard logic (maxStoneTickGain >= 0):
-     *   vanillaTicks  = ceil(1.0 / baseDamage)
-     *   boostedTicks  = ceil(1.0 / (baseDamage * rawMult))
-     *   if (vanillaTicks - boostedTicks) > maxStoneTickGain → clamp mult
-     *
-     * @param profile      a non-null profile with bonusPermille > 0
-     * @param baseDamage   Block.getDamage() result for the current block/tool pair (per-tick fraction)
-     * @param isStoneClass true when the target block's material is Material.STONE
-     * @return effective multiplier >= 1.0f to apply to the accumulated damage
+     * Calcule la duree cible en ticks pour une session de minage.
+     * Base : ceil(1.0 / boostedDamage). Applique blockOverrides (minTicks/maxTicks)
+     * et le clamp anti-instamine de HasteConfig si actif.
      */
-    public static float resolveEffectiveMult(SparrowMiningConfig.MiningProfile profile,
-                                             float baseDamage, boolean isStoneClass) {
-        float rawMult = 1.0f + profile.bonusPermille / 1000.0f;
+    public static int computeSessionTicks(MiningProfile profile, Block block, float boostedDamage) {
+        if (boostedDamage <= 0.0f) return Integer.MAX_VALUE;
+
+        int ticks = (int) Math.ceil(1.0 / (double) boostedDamage);
+        if (ticks < 1) ticks = 1;
+
+        // overrides par bloc
+        if (profile != null && profile.blockOverrides != null && !profile.blockOverrides.isEmpty() && block != null) {
+            Material mat = null;
+            try {
+                mat = CraftMagicNumbers.getMaterial(block);
+            } catch (Throwable ignored) {}
+            if (mat != null) {
+                BlockOverride ov = profile.blockOverrides.get(mat.name());
+                if (ov != null) {
+                    if (ov.minTicks > 0 && ticks < ov.minTicks) ticks = ov.minTicks;
+                    if (ov.maxTicks > 0 && ticks > ov.maxTicks) ticks = ov.maxTicks;
+                }
+            }
+        }
 
-        // No stone guard: legacy sentinel, not stone-class, or baseDamage invalid
-        if (!isStoneClass || profile.maxStoneTickGain < 0 || baseDamage <= 0.0f) {
-            return rawMult;
+        // clamp global anti-instamine
+        SparrowMiningConfig cfg = SparrowMiningConfig.get();
+        if (cfg != null && cfg.haste != null && cfg.haste.preventInstantBreak && ticks < 2) {
+            ticks = 2;
         }
+        return ticks;
+    }
 
-        // Tick-aware guard
-        int vanillaTicks = (int) Math.ceil(1.0 / (double) baseDamage);
-        int boostedTicks = (int) Math.ceil(1.0 / ((double) baseDamage * rawMult));
-        int tickGain = vanillaTicks - boostedTicks;
+    // ---------- debug ----------
 
-        if (tickGain <= profile.maxStoneTickGain) return rawMult;
+    public static boolean isDebugActive(java.util.UUID playerId) {
+        return playerId != null && debugPlayers.contains(playerId);
+    }
 
-        // Clamp to exactly maxStoneTickGain ticks of gain
-        if (profile.maxStoneTickGain == 0) return 1.0f;
-        int targetTicks = Math.max(1, vanillaTicks - profile.maxStoneTickGain);
-        // Minimum mult such that baseDamage * mult * targetTicks >= 1.0 (with epsilon for float precision)
-        float clampedMult = (float) (1.001 / ((double) baseDamage * targetTicks));
-        return Math.min(rawMult, clampedMult);
+    public static void setDebugActive(UUID playerId, boolean active) {
+        if (playerId == null) return;
+        if (active) debugPlayers.add(playerId);
+        else debugPlayers.remove(playerId);
     }
 
-    /**
-     * Returns the raw speed multiplier without tick-aware stone guard.
-     * Used in a(BlockPosition, EnumDirection) and a(BlockPosition) single-tick contexts
-     * where the per-tick clamping logic does not apply.
-     * Returns 1.0f for null, unknown, or unconfigured ids — vanilla preserved.
-     */
-    public static float getSpeedMultiplier(String sparrowId) {
-        SparrowMiningConfig.MiningProfile p = getProfile(sparrowId);
-        if (p == null) return 1.0f;
-        return Math.max(1.0f, 1.0f + p.bonusPermille / 1000.0f);
+    public static Set<UUID> debugPlayers() {
+        return debugPlayers;
     }
 }
diff --git a/src/main/java/net/minecraft/server/Block.java b/src/main/java/net/minecraft/server/Block.java
index a784e04a09ffac4d09415353084aea3fd5451d9c..da8c26fef300b23860ccddf8800ff323eb14d467 100644
--- a/src/main/java/net/minecraft/server/Block.java
+++ b/src/main/java/net/minecraft/server/Block.java
@@ -337,6 +337,12 @@ public class Block {
 
     public float getDamage(EntityHuman entityhuman, World world, BlockPosition blockposition) {
         float f = this.g(world, blockposition);
+        // SparrowItem V7 start - global block hardness override
+        float sparrowCustomHardness = com.hpfxd.pandaspigot.util.SparrowMiningRegistry.getCustomHardness(this);
+        if (sparrowCustomHardness > 0.0f) {
+            f = sparrowCustomHardness;
+        }
+        // SparrowItem V7 end
 
         return f < 0.0F ? 0.0F : (!entityhuman.b(this) ? entityhuman.a(this) / f / 100.0F : entityhuman.a(this) / f / 30.0F);
     }
diff --git a/src/main/java/net/minecraft/server/EntityHuman.java b/src/main/java/net/minecraft/server/EntityHuman.java
index 9421d207496585a87ff7d5e03f97ea0ab79ccdcb..2db37fa2491a46edc44475b6304547965a265ebc 100644
--- a/src/main/java/net/minecraft/server/EntityHuman.java
+++ b/src/main/java/net/minecraft/server/EntityHuman.java
@@ -633,6 +633,19 @@ public abstract class EntityHuman extends EntityLiving {
 
     public float a(Block block) {
         float f = this.inventory.a(block);
+        // SparrowItem V7 start - additive custom mining branch (rarityBonus + shared efficiencyBoosts + haste policy)
+        ItemStack sparrowItem = this.inventory.getItemInHand();
+        boolean sparrowCustom = com.hpfxd.pandaspigot.util.SparrowMiningRegistry.isCustomTool(sparrowItem);
+        if (sparrowCustom) {
+            f += com.hpfxd.pandaspigot.util.SparrowMiningRegistry.getRarityBonus(sparrowItem);
+            int sparrowEff = EnchantmentManager.getDigSpeedEnchantmentLevel(this);
