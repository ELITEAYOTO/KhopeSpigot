             //    int k = chunkcoordintpair1.x * 16;
             //    int l = chunkcoordintpair1.z * 16;
             // Spigot start
+            // KHopeSpigot start - 0154 world tick loaded-chunk fast path
+            //
+            // The old path performed one lookup through isChunkLoaded() and
+            // then another through getChunkAt(), which also touched the unload
+            // queue. chunkTickList only needs chunks that are already loaded,
+            // so reuse one direct ChunkProviderServer lookup instead.
+            final ChunkProviderServer khopeChunkProvider = this.chunkProviderServer;
+
             for (gnu.trove.iterator.TLongShortIterator iter = chunkTickList.iterator(); iter.hasNext(); )
             {
                 iter.advance();
                 long chunkCoord = iter.key();
                 int chunkX = World.keyToX( chunkCoord );
                 int chunkZ = World.keyToZ( chunkCoord );
-                // If unloaded, or in procedd of being unloaded, drop it
-                if ( ( !this.chunkProvider.isChunkLoaded( chunkX, chunkZ ) ) || ( this.chunkProviderServer.unloadQueue.contains( chunkX, chunkZ ) ) )
+
+                Chunk chunk = khopeChunkProvider.getChunkIfLoaded(chunkX, chunkZ);
+
+                // If unloaded, or in process of being unloaded, drop it.
+                if (chunk == null || khopeChunkProvider.unloadQueue.contains(chunkX, chunkZ))
                 {
                     iter.remove();
                     continue;
                 }
+
                 // Spigot end
                 // ChunkCoordIntPair chunkcoordintpair = (ChunkCoordIntPair) iterator.next();
                 int k = chunkX * 16;
                 int l = chunkZ * 16;
 
                 this.methodProfiler.a("getChunk");
-                Chunk chunk = this.getChunkAt(chunkX, chunkZ);
+                // KHopeSpigot end
                 // CraftBukkit end
 
                 this.a(k, l, chunk);
