 4 files changed, 73 insertions(+), 45 deletions(-)

diff --git a/src/main/java/net/minecraft/server/ChunkProviderServer.java b/src/main/java/net/minecraft/server/ChunkProviderServer.java
index f1820e277..eaf3158a5 100644
--- a/src/main/java/net/minecraft/server/ChunkProviderServer.java
+++ b/src/main/java/net/minecraft/server/ChunkProviderServer.java
@@ -5,10 +5,8 @@ import java.io.IOException;
 import java.util.ArrayDeque;
 import java.util.ArrayList;
 import java.util.Collections;
-import java.util.HashMap;
 import java.util.Iterator;
 import java.util.List;
-import java.util.Map;
 import java.util.Queue;
 import java.util.Set;
 import java.util.concurrent.ConcurrentHashMap;
@@ -54,14 +52,14 @@ public class ChunkProviderServer implements IChunkProvider {
     // bounded amount is generated each world tick.
     private final Queue<KhopePendingChunkGeneration> khopePendingChunkGenerations =
             new ArrayDeque<KhopePendingChunkGeneration>();
-    private final Map<Long, KhopePendingChunkGeneration> khopePendingChunkGenerationByKey =
-            new HashMap<Long, KhopePendingChunkGeneration>();
+    private final LongObjectHashMap<KhopePendingChunkGeneration> khopePendingChunkGenerationByKey =
+            new LongObjectHashMap<KhopePendingChunkGeneration>();
 
     private static final class KhopePendingChunkGeneration {
         private final long key;
         private final int x;
         private final int z;
-        private final long queuedNanos = System.nanoTime();
+        private final int queuedTick = MinecraftServer.currentTick;
         private final List<Runnable> callbacks = new ArrayList<Runnable>(2);
         private boolean cancelled;
 
@@ -229,11 +227,10 @@ public class ChunkProviderServer implements IChunkProvider {
             return;
         }
 
-        final Long boxedKey = Long.valueOf(key);
-        KhopePendingChunkGeneration pending = this.khopePendingChunkGenerationByKey.get(boxedKey);
+        KhopePendingChunkGeneration pending = this.khopePendingChunkGenerationByKey.get(key);
         if (pending == null) {
             pending = new KhopePendingChunkGeneration(key, x, z);
-            this.khopePendingChunkGenerationByKey.put(boxedKey, pending);
+            this.khopePendingChunkGenerationByKey.put(key, pending);
             this.khopePendingChunkGenerations.add(pending);
         }
 
@@ -247,7 +244,7 @@ public class ChunkProviderServer implements IChunkProvider {
             return;
         }
 
-        final Long key = Long.valueOf(LongHash.toLong(x, z));
+        final long key = LongHash.toLong(x, z);
         final KhopePendingChunkGeneration pending = this.khopePendingChunkGenerationByKey.get(key);
         if (pending == null) {
             return;
@@ -287,7 +284,7 @@ public class ChunkProviderServer implements IChunkProvider {
             // Discard stale/cancelled queue nodes in O(1) from the head.
             while (pending != null
                     && (pending.cancelled
-                    || this.khopePendingChunkGenerationByKey.get(Long.valueOf(pending.key)) != pending)) {
+                    || this.khopePendingChunkGenerationByKey.get(pending.key) != pending)) {
                 this.khopePendingChunkGenerations.poll();
                 pending = this.khopePendingChunkGenerations.peek();
             }
@@ -311,7 +308,7 @@ public class ChunkProviderServer implements IChunkProvider {
             }
 
             this.khopePendingChunkGenerations.poll();
-            this.khopePendingChunkGenerationByKey.remove(Long.valueOf(pending.key));
+            this.khopePendingChunkGenerationByKey.remove(pending.key);
 
             // Another path may have loaded/generated the chunk while this
             // request was waiting. In that case only complete the callbacks.
@@ -332,24 +329,27 @@ public class ChunkProviderServer implements IChunkProvider {
             }
         }
 
-        final KhopePendingChunkGeneration oldest = this.peekKhopePendingChunkGeneration();
-        final long oldestAgeNanos = oldest == null
-                ? 0L
-                : Math.max(0L, System.nanoTime() - oldest.queuedNanos);
-
-        com.hpfxd.pandaspigot.util.KhopePerformanceDiagnostics.recordDeferredChunkGenerationBudget(
-                generated,
-                this.khopePendingChunkGenerationByKey.size(),
-                System.nanoTime() - startNanos,
-                budgetHit,
-                oldestAgeNanos);
+        if (com.hpfxd.pandaspigot.util.KhopePerformanceDiagnostics.isSlowPathCaptureEnabled()) {
+            final KhopePendingChunkGeneration oldest = this.peekKhopePendingChunkGeneration();
+            final long oldestAgeTicks = oldest == null
+                    ? 0L
+                    : Math.max(0L, (long) MinecraftServer.currentTick - (long) oldest.queuedTick);
+            final long oldestAgeNanos = oldestAgeTicks * 50_000_000L;
+
+            com.hpfxd.pandaspigot.util.KhopePerformanceDiagnostics.recordDeferredChunkGenerationBudget(
+                    generated,
+                    this.khopePendingChunkGenerationByKey.size(),
+                    System.nanoTime() - startNanos,
+                    budgetHit,
+                    oldestAgeNanos);
+        }
     }
 
     private KhopePendingChunkGeneration peekKhopePendingChunkGeneration() {
         KhopePendingChunkGeneration pending = this.khopePendingChunkGenerations.peek();
         while (pending != null
                 && (pending.cancelled
-                || this.khopePendingChunkGenerationByKey.get(Long.valueOf(pending.key)) != pending)) {
+                || this.khopePendingChunkGenerationByKey.get(pending.key) != pending)) {
             this.khopePendingChunkGenerations.poll();
             pending = this.khopePendingChunkGenerations.peek();
         }
