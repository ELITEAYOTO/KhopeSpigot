+
+            if (worstTracedJobNanos > 0L) {
+                sender.sendMessage(ChatColor.GOLD + "--- Worst FutureTask attribution ---");
+                sender.sendMessage(ChatColor.GRAY + "Task: " + ChatColor.RED + formatMs(worstTracedJobNanos)
+                        + ChatColor.GRAY + " | command " + ChatColor.YELLOW + worstTracedJobCommand
+                        + ChatColor.GRAY + " / " + formatMs(worstTracedJobCommandNanos));
+
+                sender.sendMessage(ChatColor.GRAY + "Loaded hits=" + worstTracedJobLoadedHits
+                        + " exists=" + worstTracedJobChunkExistsChecks
+                        + "/" + formatMs(worstTracedJobChunkExistsNanos)
+                        + " asyncQ=" + worstTracedJobAsyncChunkQueues);
+
+                sender.sendMessage(ChatColor.GRAY + "SyncLoad=" + worstTracedJobSyncChunkLoads
+                        + "/" + formatMs(worstTracedJobSyncChunkLoadNanos)
+                        + " direct=" + worstTracedJobDirectChunkLoads
+                        + "/" + formatMs(worstTracedJobDirectChunkLoadNanos));
+
+                sender.sendMessage(ChatColor.GRAY + "Generate=" + worstTracedJobChunkGenerations
+                        + "/" + formatMs(worstTracedJobChunkGenerationNanos)
+                        + " finalize=" + worstTracedJobChunkFinalizations
+                        + "/" + formatMs(worstTracedJobChunkFinalizeNanos));
+            }
         } else {
             sender.sendMessage(ChatColor.DARK_GRAY
                     + "Aucune capture detaillee. Utilise /khope perf detail 60 ou jobs 30.");
