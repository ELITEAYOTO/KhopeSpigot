+    /**
+     * True only during an explicit /khope perf jobs capture on the primary
+     * server thread. Normal production mode has no command/chunk tracing.
+     */
+    public static boolean isSlowPathCaptureEnabled() {
+        return jobsThisTick && MinecraftServer.getServer().isMainThread();
+    }
+
+    public static void beginJobTrace() {
+        if (!isSlowPathCaptureEnabled()) {
+            jobTraceActive = false;
+            return;
+        }
+
+        jobTraceActive = true;
+        currentJobCommand = "-";
+        currentJobCommandNanos = 0L;
+        currentJobLoadedHits = 0L;
+        currentJobChunkExistsChecks = 0L;
+        currentJobChunkExistsNanos = 0L;
+        currentJobAsyncChunkQueues = 0L;
+        currentJobSyncChunkLoads = 0L;
+        currentJobSyncChunkLoadNanos = 0L;
+        currentJobDirectChunkLoads = 0L;
+        currentJobDirectChunkLoadNanos = 0L;
+        currentJobChunkGenerations = 0L;
+        currentJobChunkGenerationNanos = 0L;
+        currentJobChunkFinalizations = 0L;
+        currentJobChunkFinalizeNanos = 0L;
+    }
+
+    public static void endJobTrace(long jobNanos) {
+        if (!jobTraceActive) {
+            return;
+        }
+
+        if (jobNanos > worstTracedJobNanos) {
+            worstTracedJobNanos = jobNanos;
+            worstTracedJobCommand = currentJobCommand;
+            worstTracedJobCommandNanos = currentJobCommandNanos;
+            worstTracedJobLoadedHits = currentJobLoadedHits;
+            worstTracedJobChunkExistsChecks = currentJobChunkExistsChecks;
+            worstTracedJobChunkExistsNanos = currentJobChunkExistsNanos;
+            worstTracedJobAsyncChunkQueues = currentJobAsyncChunkQueues;
+            worstTracedJobSyncChunkLoads = currentJobSyncChunkLoads;
+            worstTracedJobSyncChunkLoadNanos = currentJobSyncChunkLoadNanos;
+            worstTracedJobDirectChunkLoads = currentJobDirectChunkLoads;
+            worstTracedJobDirectChunkLoadNanos = currentJobDirectChunkLoadNanos;
+            worstTracedJobChunkGenerations = currentJobChunkGenerations;
+            worstTracedJobChunkGenerationNanos = currentJobChunkGenerationNanos;
+            worstTracedJobChunkFinalizations = currentJobChunkFinalizations;
+            worstTracedJobChunkFinalizeNanos = currentJobChunkFinalizeNanos;
+        }
+
+        jobTraceActive = false;
+    }
+
+    public static void recordPlayerCommand(String rawCommand, long nanos) {
+        if (!isSlowPathCaptureEnabled() || nanos < 0L) {
+            return;
+        }
+
+        final String command = commandLabel(rawCommand);
+        ++commandCount;
+        commandTotalNanos += nanos;
+
+        if (nanos > commandMaxNanos) {
+            commandMaxNanos = nanos;
+            worstCommand = command;
+        }
+
+        if (jobTraceActive && nanos > currentJobCommandNanos) {
+            currentJobCommand = command;
+            currentJobCommandNanos = nanos;
+        }
+    }
+
+    public static void recordLoadedChunkHit() {
+        if (!isSlowPathCaptureEnabled()) return;
+        ++loadedChunkHits;
+        if (jobTraceActive) ++currentJobLoadedHits;
+    }
+
+    public static void recordChunkExistsCheck(long nanos) {
+        if (!isSlowPathCaptureEnabled() || nanos < 0L) return;
+        ++chunkExistsChecks;
+        chunkExistsCheckTotalNanos += nanos;
+        if (nanos > chunkExistsCheckMaxNanos) chunkExistsCheckMaxNanos = nanos;
+
+        if (jobTraceActive) {
+            ++currentJobChunkExistsChecks;
+            currentJobChunkExistsNanos += nanos;
+        }
+    }
+
+    public static void recordAsyncChunkQueue() {
+        if (!isSlowPathCaptureEnabled()) return;
+        ++asyncChunkQueues;
+        if (jobTraceActive) ++currentJobAsyncChunkQueues;
+    }
+
+    public static void recordSyncChunkLoad(long nanos) {
+        if (!isSlowPathCaptureEnabled() || nanos < 0L) return;
+        ++syncChunkLoads;
+        syncChunkLoadTotalNanos += nanos;
+        if (nanos > syncChunkLoadMaxNanos) syncChunkLoadMaxNanos = nanos;
+
+        if (jobTraceActive) {
+            ++currentJobSyncChunkLoads;
+            currentJobSyncChunkLoadNanos += nanos;
+        }
+    }
+
+    public static void recordDirectChunkLoad(long nanos) {
+        if (!isSlowPathCaptureEnabled() || nanos < 0L) return;
+        ++directChunkLoads;
+        directChunkLoadTotalNanos += nanos;
+        if (nanos > directChunkLoadMaxNanos) directChunkLoadMaxNanos = nanos;
+
+        if (jobTraceActive) {
+            ++currentJobDirectChunkLoads;
+            currentJobDirectChunkLoadNanos += nanos;
+        }
+    }
+
+    public static void recordChunkGeneration(long nanos) {
+        if (!isSlowPathCaptureEnabled() || nanos < 0L) return;
+        ++chunkGenerations;
+        chunkGenerationTotalNanos += nanos;
+        if (nanos > chunkGenerationMaxNanos) chunkGenerationMaxNanos = nanos;
+
+        if (jobTraceActive) {
+            ++currentJobChunkGenerations;
+            currentJobChunkGenerationNanos += nanos;
+        }
+    }
+
+    public static void recordChunkFinalization(long nanos) {
+        if (!isSlowPathCaptureEnabled() || nanos < 0L) return;
+        ++chunkFinalizations;
+        chunkFinalizeTotalNanos += nanos;
+        if (nanos > chunkFinalizeMaxNanos) chunkFinalizeMaxNanos = nanos;
+
+        if (jobTraceActive) {
+            ++currentJobChunkFinalizations;
+            currentJobChunkFinalizeNanos += nanos;
+        }
+    }
+
     public static void recordSection(int section, long nanos) {
         if (!detailThisTick
                 || section < 0
@@ -425,6 +636,63 @@ public final class KhopePerformanceDiagnostics {
                         + ChatColor.GRAY + " | work=" + ChatColor.YELLOW + formatMs(worstTickJobWorkNanos)
