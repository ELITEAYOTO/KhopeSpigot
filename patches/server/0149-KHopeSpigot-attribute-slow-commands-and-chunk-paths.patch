+    private static String commandLabel(String command) {
+        if (command == null || command.length() == 0) {
+            return "-";
+        }
+
+        final int length = command.length();
+        int end = 0;
+        while (end < length && !Character.isWhitespace(command.charAt(end))) {
+            ++end;
+        }
+
+        return end == length ? command : command.substring(0, end);
     }
 
     private static void finalizeBreakdown(long activeNanos) {
