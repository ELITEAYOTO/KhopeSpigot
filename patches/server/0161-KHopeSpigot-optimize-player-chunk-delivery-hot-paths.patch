diff --git a/src/main/java/net/minecraft/server/ChunkProviderServer.java b/src/main/java/net/minecraft/server/ChunkProviderServer.java
index eaf3158a5..3acb162fe 100644
--- a/src/main/java/net/minecraft/server/ChunkProviderServer.java
+++ b/src/main/java/net/minecraft/server/ChunkProviderServer.java
@@ -148,6 +148,25 @@ public class ChunkProviderServer implements IChunkProvider {
         return chunks.get(LongHash.toLong(x, z));
     }
 
+    // KHopeSpigot start - 0161 loaded player-chunk delivery fast path
+    // EntityPlayer's send queue only wants chunks that are already loaded. The
+    // old path first queried isLoaded() and then called getChunkAt(), performing
+    // a second map lookup. Preserve getChunkAt()'s unload-cancellation and
+    // diagnostics without entering its load/generation machinery.
+    public Chunk getLoadedChunkForPlayerSend(int x, int z) {
+        final Chunk chunk = chunks.get(LongHash.toLong(x, z));
+        if (chunk == null) {
+            return null;
+        }
+
+        unloadQueue.remove(x, z);
+        if (com.hpfxd.pandaspigot.util.KhopePerformanceDiagnostics.isSlowPathCaptureEnabled()) {
+            com.hpfxd.pandaspigot.util.KhopePerformanceDiagnostics.recordLoadedChunkHit();
+        }
+        return chunk;
+    }
+    // KHopeSpigot end
+
     public Chunk getChunkAt(int i, int j) {
         return getChunkAt(i, j, null);
     }
