From 0f75c2cde79f5970956e60a15063fee91207f81f Mon Sep 17 00:00:00 2001
From: Timothe <timothe.renou@gmail.com>
Date: Mon, 17 Aug 2026 12:19:33 +0200
Subject: [PATCH] KHopeSpigot: optimize scheduled tick queue hot paths

---
 .../net/minecraft/server/WorldServer.java     | 51 ++++++++++++++-----
 1 file changed, 37 insertions(+), 14 deletions(-)

diff --git a/src/main/java/net/minecraft/server/WorldServer.java b/src/main/java/net/minecraft/server/WorldServer.java
index 8f9973f99..dff0f03c9 100644
--- a/src/main/java/net/minecraft/server/WorldServer.java
+++ b/src/main/java/net/minecraft/server/WorldServer.java
@@ -48,7 +48,15 @@ public class WorldServer extends World implements IAsyncTaskHandler {
     private WorldServer.BlockActionDataList[] S = new WorldServer.BlockActionDataList[] { new WorldServer.BlockActionDataList(null), new WorldServer.BlockActionDataList(null)};
     private int T;
     private static final List<StructurePieceTreasure> U = Lists.newArrayList(new StructurePieceTreasure[] { new StructurePieceTreasure(Items.STICK, 0, 1, 3, 10), new StructurePieceTreasure(Item.getItemOf(Blocks.PLANKS), 0, 1, 3, 10), new StructurePieceTreasure(Item.getItemOf(Blocks.LOG), 0, 1, 3, 10), new StructurePieceTreasure(Items.STONE_AXE, 0, 1, 1, 3), new StructurePieceTreasure(Items.WOODEN_AXE, 0, 1, 1, 5), new StructurePieceTreasure(Items.STONE_PICKAXE, 0, 1, 1, 3), new StructurePieceTreasure(Items.WOODEN_PICKAXE, 0, 1, 1, 5), new StructurePieceTreasure(Items.APPLE, 0, 2, 3, 5), new StructurePieceTreasure(Items.BREAD, 0, 2, 3, 3), new StructurePieceTreasure(Item.getItemOf(Blocks.LOG2), 0, 1, 3, 10)});
-    private List<NextTickListEntry> V = Lists.newArrayList();
+    // KHopeSpigot start - 0159 scheduled tick queue fast path
+    //
+    // V is a FIFO of entries due during the current world tick. The previous
+    // ArrayList was consumed with Iterator.remove(), shifting the remaining
+    // array on every entry (quadratic behavior under large redstone/crop
+    // batches). ArrayDeque preserves FIFO/contains/iterator semantics while
+    // making head removal O(1).
+    private final ArrayDeque<NextTickListEntry> V = new ArrayDeque<NextTickListEntry>();
+    // KHopeSpigot end
     public boolean hasEntityMoveEvent = false; // PandaSpigot
     public boolean hasPhysicsEvent = true; // PandaSpigot
 
@@ -692,7 +700,8 @@ public class WorldServer extends World implements IAsyncTaskHandler {
                             break;
                         }
 
-                        if (next.a().isPowerSource() || next.a() instanceof IContainer) {
+                        final Block scheduledBlock = next.a();
+                        if (scheduledBlock.isPowerSource() || scheduledBlock instanceof IContainer) {
                             iterator.remove();
                             this.V.add(next);
                         }
@@ -703,22 +712,31 @@ public class WorldServer extends World implements IAsyncTaskHandler {
                 this.methodProfiler.b();
                 this.methodProfiler.a("ticking");
                 timings.scheduledBlocksTicking.startTiming(); // Spigot
-                Iterator iterator = this.V.iterator();
-
-                while (iterator.hasNext()) {
-                    nextticklistentry = (NextTickListEntry) iterator.next();
-                    iterator.remove();
-
+                while ((nextticklistentry = this.V.pollFirst()) != null) {
                     final BlockPosition khopeTickPosition = nextticklistentry.a;
                     final Block khopeScheduledBlock = nextticklistentry.a();
 
-                    if (this.areChunksLoadedBetween(khopeTickPosition, khopeTickPosition)) {
-                        IBlockData iblockdata = this.getType(khopeTickPosition);
+                    // KHopeSpigot start - 0159 loaded scheduled-tick fast path
+                    //
+                    // The old path first checked the one-position area for a
+                    // loaded chunk, then getType() looked the same chunk up
+                    // again. getTypeIfLoaded() preserves captured-state lookup
+                    // and performs one loaded-chunk query.
+                    final int khopeTickY = khopeTickPosition.getY();
+                    final IBlockData iblockdata =
+                            khopeTickY >= 0 && khopeTickY < 256
+                                    ? this.getTypeIfLoaded(khopeTickPosition)
+                                    : null;
+
+                    if (iblockdata != null) {
                         final Block khopeCurrentBlock = iblockdata.getBlock();
-                        co.aikar.timings.Timing timing = khopeCurrentBlock.getTiming(); // Spigot
-                        timing.startTiming(); // Spigot
 
-                        if (khopeCurrentBlock.getMaterial() != Material.AIR && Block.a(khopeCurrentBlock, khopeScheduledBlock)) {
+                        // Do not enter a block timing section for stale/air
+                        // scheduled entries that will not execute a callback.
+                        if (khopeCurrentBlock.getMaterial() != Material.AIR
+                                && Block.a(khopeCurrentBlock, khopeScheduledBlock)) {
+                            co.aikar.timings.Timing timing = khopeCurrentBlock.getTiming(); // Spigot
+                            timing.startTiming(); // Spigot
                             try {
                                 khopeCurrentBlock.b((World) this, khopeTickPosition, iblockdata, this.random);
                             } catch (Throwable throwable) {
@@ -727,12 +745,17 @@ public class WorldServer extends World implements IAsyncTaskHandler {
 
                                 CrashReportSystemDetails.a(crashreportsystemdetails, khopeTickPosition, iblockdata);
                                 throw new ReportedException(crashreport);
+                            } finally {
+                                timing.stopTiming(); // Spigot
                             }
                         }
-                        timing.stopTiming(); // Spigot
                     } else {
+                        // Preserve vanilla/Paper behavior: entries whose chunk
+                        // is not loaded (or whose Y is outside the world) are
+                        // scheduled again rather than executed immediately.
                         this.a(khopeTickPosition, khopeScheduledBlock, 0);
                     }
+                    // KHopeSpigot end
                 }
                 timings.scheduledBlocksTicking.stopTiming(); // Spigot
 
