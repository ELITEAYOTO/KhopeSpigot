@@ -233,6 +279,9 @@ public final class KhopePerformanceDiagnostics {
         for (int i = 0; i < SECTION_COUNT; ++i) {
             CURRENT_SECTION_NANOS[i] = 0L;
         }
+        for (int i = 0; i < WORLD_SECTION_COUNT; ++i) {
+            CURRENT_WORLD_SECTION_NANOS[i] = 0L;
