+        }
 
         Arrays.fill(CURRENT_SECTION_NANOS, 0L);
         Arrays.fill(SECTION_TOTAL_NANOS, 0L);
         Arrays.fill(SECTION_MAX_NANOS, 0L);
         Arrays.fill(WORST_SECTION_NANOS, 0L);
 
+        Arrays.fill(CURRENT_WORLD_SECTION_NANOS, 0L);
+        Arrays.fill(WORLD_SECTION_TOTAL_NANOS, 0L);
+        Arrays.fill(WORLD_SECTION_MAX_NANOS, 0L);
