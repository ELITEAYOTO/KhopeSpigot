@@ -484,6 +533,22 @@ public final class KhopePerformanceDiagnostics {
         return now;
     }
 
+    public static void recordWorldSection(int section, long nanos) {
+        if (!detailThisTick
+                || section < 0
+                || section >= WORLD_ACCOUNTED_SECTION_COUNT
+                || nanos <= 0L) {
+            return;
+        }
+        CURRENT_WORLD_SECTION_NANOS[section] += nanos;
+    }
+
+    public static long endWorldSection(int section, long startNanos) {
+        final long now = System.nanoTime();
+        recordWorldSection(section, now - startNanos);
+        return now;
+    }
