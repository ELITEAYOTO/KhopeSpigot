                 Arrays.fill(sectionNanos[section], 0L);
             }
         }
+        if (worldSectionNanos != null) {
+            for (int section = 0; section < WORLD_SECTION_COUNT; ++section) {
+                Arrays.fill(worldSectionNanos[section], 0L);
