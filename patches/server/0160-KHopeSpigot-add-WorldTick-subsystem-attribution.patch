     public static void recordJobs(
             int count,
             long workNanos,
@@ -706,6 +771,35 @@ public final class KhopePerformanceDiagnostics {
                 sendSectionLine(sender, section);
             }
 
+            if (worldSectionNanos != null && SECTION_TOTAL_NANOS[SECTION_WORLD_TICK] > 0L) {
+                sender.sendMessage(ChatColor.GOLD + "--- WorldTick breakdown 0160 ---");
+                for (int section = 0; section < WORLD_SECTION_COUNT; ++section) {
+                    sendWorldSectionLine(sender, section);
+                }
+
+                final long worldTickTotal = SECTION_TOTAL_NANOS[SECTION_WORLD_TICK];
+                final long worldUnaccounted = WORLD_SECTION_TOTAL_NANOS[WORLD_SECTION_OTHER];
+                final long worldAccounted = Math.max(0L, worldTickTotal - worldUnaccounted);
+                final double accountedPercent = worldTickTotal == 0L
+                        ? 0.0D
+                        : Math.min(100.0D, (double) worldAccounted * 100.0D / (double) worldTickTotal);
+
+                sender.sendMessage(ChatColor.GRAY + "WorldTick accounted: " + ChatColor.GREEN
+                        + formatMs(detailTickCount == 0L ? 0L : worldAccounted / detailTickCount)
+                        + ChatColor.GRAY + " / "
+                        + formatMs(detailTickCount == 0L ? 0L : worldTickTotal / detailTickCount)
+                        + ChatColor.GRAY + " = " + ChatColor.YELLOW + formatDouble(accountedPercent) + "%");
+                sender.sendMessage(ChatColor.GRAY + "WorldTick unaccounted: " + ChatColor.YELLOW
+                        + formatMs(detailTickCount == 0L ? 0L : worldUnaccounted / detailTickCount));
+
+                if (detailWorstWorldTickNanos > 0L) {
+                    sender.sendMessage(ChatColor.GOLD + "--- Pire WorldTick detail #"
+                            + detailWorstWorldTickNumber + ": "
+                            + formatMs(detailWorstWorldTickNanos) + " ---");
+                    sendWorstWorldSections(sender, 6);
+                }
+            }
+
