+    // 0160 - second-level WorldTick attribution. These sections are only
+    // recorded during an explicit /khope perf detail/jobs capture.
+    public static final int WORLD_SECTION_WEATHER = 0;
+    public static final int WORLD_SECTION_BASE = 1;
+    public static final int WORLD_SECTION_MOB_SPAWN = 2;
+    public static final int WORLD_SECTION_CHUNK_UNLOAD = 3;
+    public static final int WORLD_SECTION_SCHEDULED_TICKS = 4;
+    public static final int WORLD_SECTION_CHUNK_TICK = 5;
+    public static final int WORLD_SECTION_ANTI_XRAY = 6;
+    public static final int WORLD_SECTION_PLAYER_CHUNKS = 7;
+    public static final int WORLD_SECTION_VILLAGES = 8;
+    public static final int WORLD_SECTION_PORTAL_FORCER = 9;
+    public static final int WORLD_SECTION_SOUNDS = 10;
+    public static final int WORLD_SECTION_CHUNK_GC = 11;
+    public static final int WORLD_SECTION_OTHER = 12;
+
+    private static final int WORLD_SECTION_COUNT = 13;
+    private static final int WORLD_ACCOUNTED_SECTION_COUNT = WORLD_SECTION_OTHER;
+
+    private static final String[] WORLD_SECTION_NAMES = {
+            "Weather",
+            "WorldBase",
+            "MobSpawn",
+            "ChunkUnload",
+            "ScheduledTicks",
+            "ChunkTick",
+            "AntiXray",
+            "PlayerChunks",
+            "Villages",
+            "PortalForcer",
+            "Sounds",
+            "ChunkGC",
+            "WorldOther"
+    };
+
     private static final long[] TICK_NANOS = new long[SAMPLE_CAPACITY];
     private static final long[] WAIT_NANOS = new long[SAMPLE_CAPACITY];
 
@@ -103,6 +138,14 @@ public final class KhopePerformanceDiagnostics {
     private static final long[] SECTION_MAX_NANOS = new long[SECTION_COUNT];
     private static final long[] WORST_SECTION_NANOS = new long[SECTION_COUNT];
 
+    // 0160 - WorldTick second-level samples, accumulated across all worlds
+    // into the current server tick.
+    private static long[][] worldSectionNanos;
+    private static final long[] CURRENT_WORLD_SECTION_NANOS = new long[WORLD_SECTION_COUNT];
+    private static final long[] WORLD_SECTION_TOTAL_NANOS = new long[WORLD_SECTION_COUNT];
+    private static final long[] WORLD_SECTION_MAX_NANOS = new long[WORLD_SECTION_COUNT];
+    private static final long[] WORST_WORLD_SECTION_NANOS = new long[WORLD_SECTION_COUNT];
+
     private static long detailWindowStartNanos;
     private static long detailWindowLastNanos;
     private static long detailTickCount;
@@ -111,6 +154,9 @@ public final class KhopePerformanceDiagnostics {
