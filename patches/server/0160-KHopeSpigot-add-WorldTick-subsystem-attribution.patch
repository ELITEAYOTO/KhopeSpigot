         detailSampleCount = 0;
         detailWorstTickNanos = 0L;
         detailWorstTickNumber = 0L;
+        detailWorstWorldTickNanos = 0L;
+        detailWorstWorldTickNumber = 0L;
 
         jobsTaskCountTotal = 0L;
         jobsWorkNanosTotal = 0L;
@@ -1062,6 +1171,15 @@ public final class KhopePerformanceDiagnostics {
         CURRENT_SECTION_NANOS[SECTION_OTHER] =
                 activeNanos > accountedNanos ? activeNanos - accountedNanos : 0L;
 
+        final long worldTickNanos = CURRENT_SECTION_NANOS[SECTION_WORLD_TICK];
+        long worldAccountedNanos = 0L;
+        for (int section = 0; section < WORLD_ACCOUNTED_SECTION_COUNT; ++section) {
+            worldAccountedNanos += CURRENT_WORLD_SECTION_NANOS[section];
+        }
+
+        CURRENT_WORLD_SECTION_NANOS[WORLD_SECTION_OTHER] =
+                worldTickNanos > worldAccountedNanos ? worldTickNanos - worldAccountedNanos : 0L;
+
         final int sampleIndex = detailSampleIndex;
         for (int section = 0; section < SECTION_COUNT; ++section) {
             final long value = CURRENT_SECTION_NANOS[section];
@@ -1070,6 +1188,13 @@ public final class KhopePerformanceDiagnostics {
             if (value > SECTION_MAX_NANOS[section]) SECTION_MAX_NANOS[section] = value;
         }
 
+        for (int section = 0; section < WORLD_SECTION_COUNT; ++section) {
+            final long value = CURRENT_WORLD_SECTION_NANOS[section];
+            worldSectionNanos[section][sampleIndex] = value;
+            WORLD_SECTION_TOTAL_NANOS[section] += value;
+            if (value > WORLD_SECTION_MAX_NANOS[section]) WORLD_SECTION_MAX_NANOS[section] = value;
+        }
+
         ++detailTickCount;
         detailWindowLastNanos = System.nanoTime();
 
@@ -1082,6 +1207,17 @@ public final class KhopePerformanceDiagnostics {
             worstTickJobMaxNanos = currentJobMaxNanos;
         }
 
+        if (worldTickNanos > detailWorstWorldTickNanos) {
+            detailWorstWorldTickNanos = worldTickNanos;
+            detailWorstWorldTickNumber = detailTickCount;
+            System.arraycopy(
+                    CURRENT_WORLD_SECTION_NANOS,
+                    0,
+                    WORST_WORLD_SECTION_NANOS,
+                    0,
+                    WORLD_SECTION_COUNT);
+        }
+
         if (++detailSampleIndex == SAMPLE_CAPACITY) detailSampleIndex = 0;
         if (detailSampleCount < SAMPLE_CAPACITY) ++detailSampleCount;
     }
@@ -1098,6 +1234,23 @@ public final class KhopePerformanceDiagnostics {
                 + ChatColor.GRAY + " | max " + ChatColor.RED + formatMs(SECTION_MAX_NANOS[section]));
     }
 
+    private static void sendWorldSectionLine(CommandSender sender, int section) {
+        final long[] samples = snapshot(
+                worldSectionNanos[section],
+                detailSampleIndex,
+                detailSampleCount);
+        Arrays.sort(samples);
+
+        final long average = detailTickCount == 0L
+                ? 0L
+                : WORLD_SECTION_TOTAL_NANOS[section] / detailTickCount;
+        sender.sendMessage(ChatColor.GRAY + WORLD_SECTION_NAMES[section]
+                + " avg " + ChatColor.GREEN + formatMs(average)
+                + ChatColor.GRAY + " | p95 " + ChatColor.YELLOW + formatMs(percentile(samples, 95))
+                + ChatColor.GRAY + " | p99 " + ChatColor.YELLOW + formatMs(percentile(samples, 99))
+                + ChatColor.GRAY + " | max " + ChatColor.RED + formatMs(WORLD_SECTION_MAX_NANOS[section]));
+    }
+
     private static void sendWorstSections(CommandSender sender, int limit) {
         final boolean[] used = new boolean[SECTION_COUNT];
 
@@ -1120,6 +1273,29 @@ public final class KhopePerformanceDiagnostics {
         }
     }
 
+    private static void sendWorstWorldSections(CommandSender sender, int limit) {
+        final boolean[] used = new boolean[WORLD_SECTION_COUNT];
+
+        for (int rank = 1; rank <= limit; ++rank) {
+            int bestSection = -1;
+            long bestNanos = -1L;
+
+            for (int section = 0; section < WORLD_SECTION_COUNT; ++section) {
+                if (!used[section] && WORST_WORLD_SECTION_NANOS[section] > bestNanos) {
+                    bestSection = section;
+                    bestNanos = WORST_WORLD_SECTION_NANOS[section];
+                }
+            }
+
+            if (bestSection < 0 || bestNanos <= 0L) return;
+
+            used[bestSection] = true;
+            sender.sendMessage(ChatColor.GRAY + "#" + rank + " "
+                    + WORLD_SECTION_NAMES[bestSection] + ": "
+                    + ChatColor.YELLOW + formatMs(bestNanos));
+        }
+    }
+
     private static long[] snapshot(long[] source, int nextIndex, int count) {
         if (count <= 0) return new long[0];
 
