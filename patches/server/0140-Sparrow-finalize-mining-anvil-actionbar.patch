+    // ---------- V8 : categories de blocs ----------
+
+    /** Cache materialName -> categoryName, reconstruit a chaque init()/reload. */
+    private static volatile Map<String, String> materialToCategoryCache = new HashMap<>();
+
+    /** Retourne la categorie du bloc (ex: "STONE", "ORE", "HARD") ou "DEFAULT" si inconnu. */
+    public static String resolveCategory(String materialName) {
+        if (materialName == null || materialName.isEmpty()) return "DEFAULT";
+        return materialToCategoryCache.getOrDefault(materialName, "DEFAULT");
+    }
+
+    private static void buildCategoryCache(SparrowMiningConfig cfg) {
+        Map<String, String> cache = new HashMap<>();
+        if (cfg.blockCategories != null) {
+            for (Map.Entry<String, List<String>> entry : cfg.blockCategories.entrySet()) {
+                if (entry.getValue() != null) {
+                    for (String rawEntry : entry.getValue()) {
+                        // Supporte les deux formats : une entree par ligne ET liste CSV separee par virgule
+                        for (String matName : rawEntry.split(",")) {
+                            String trimmed = matName.trim();
+                            if (!trimmed.isEmpty()) {
+                                cache.put(trimmed, entry.getKey());
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        materialToCategoryCache = cache;
+    }
