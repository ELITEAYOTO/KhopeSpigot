diff --git a/src/main/java/com/hpfxd/pandaspigot/api/SparrowAnvilAPI.java b/src/main/java/com/hpfxd/pandaspigot/api/SparrowAnvilAPI.java
new file mode 100644
index 0000000000000000000000000000000000000000..2cc2f915f40b779e512db5088da73b8315823b9c
--- /dev/null
+++ b/src/main/java/com/hpfxd/pandaspigot/api/SparrowAnvilAPI.java
@@ -0,0 +1,129 @@
+package com.hpfxd.pandaspigot.api;
+
+import org.bukkit.craftbukkit.inventory.CraftItemStack;
+import org.bukkit.inventory.ItemStack;
+
+import com.hpfxd.pandaspigot.util.SparrowItem;
+
+import net.minecraft.server.NBTTagCompound;
+
+/**
+ * API publique pour les plugins Bukkit (PluginCIT, Kenchantement, ...).
+ *
+ * Verifie la compatibilite entre un livre custom "Minage Rapide" et une pioche custom,
+ * et expose les tags NBT lus/ecrits par le fork (sparrowmc-item, sparrowmc-mining-speed,
+ * sparrowmc-enchant, sparrowmc-enchant-level, sparrowmc-enchant-tier).
+ *
+ * Les plugins restent libres d'ecrire les tags NBT eux-memes (via NBT-API ou autre) ;
+ * cette API ne fait QUE lire et valider, jamais modifier.
+ *
+ * Thread-safety : tous les accesseurs sont sans etat et thread-safe.
+ */
+public final class SparrowAnvilAPI {
+
+    public static final String ITEM_TAG          = SparrowItem.CUSTOM_ID_KEY;     // "sparrowmc-item"
+    public static final String MINING_SPEED_TAG  = SparrowItem.MINING_SPEED_KEY;  // "sparrowmc-mining-speed"
+    public static final String ENCHANT_TAG       = "sparrowmc-enchant";
+    public static final String ENCHANT_LEVEL_TAG = "sparrowmc-enchant-level";
+    public static final String ENCHANT_TIER_TAG  = "sparrowmc-enchant-tier";
+
+    public static final String ENCHANT_MINAGE_RAPIDE = "minage_rapide";
+
+    private SparrowAnvilAPI() {}
+
+    // ----- accesseurs Bukkit -> NMS -----
+
+    private static NBTTagCompound tagOf(ItemStack item) {
+        if (item == null) return null;
+        net.minecraft.server.ItemStack nms = CraftItemStack.asNMSCopy(item);
+        if (nms == null || !nms.hasTag()) return null;
+        return nms.getTag();
+    }
+
+    /** Retourne l'id custom de l'item (tag sparrowmc-item), ou null si absent. */
+    public static String getCustomId(ItemStack item) {
+        NBTTagCompound tag = tagOf(item);
+        if (tag == null || !tag.hasKeyOfType(ITEM_TAG, 8)) return null;
+        String v = tag.getString(ITEM_TAG);
+        return (v == null || v.isEmpty()) ? null : v;
+    }
+
+    /** Retourne le niveau de Minage Rapide pose sur la pioche (0 = aucun). */
+    public static int getMiningSpeedLevel(ItemStack pickaxe) {
+        NBTTagCompound tag = tagOf(pickaxe);
+        if (tag == null || !tag.hasKeyOfType(MINING_SPEED_TAG, 3)) return 0;
+        int v = tag.getInt(MINING_SPEED_TAG);
+        return Math.max(0, v);
+    }
+
+    /** Retourne l'id d'enchant du livre (ex: "minage_rapide"), ou null. */
+    public static String getEnchantId(ItemStack book) {
+        NBTTagCompound tag = tagOf(book);
+        if (tag == null || !tag.hasKeyOfType(ENCHANT_TAG, 8)) return null;
+        String v = tag.getString(ENCHANT_TAG);
+        return (v == null || v.isEmpty()) ? null : v;
+    }
+
+    /** Retourne le niveau de l'enchant porte par le livre (>=1), ou 0 si absent. */
+    public static int getEnchantLevel(ItemStack book) {
+        NBTTagCompound tag = tagOf(book);
+        if (tag == null || !tag.hasKeyOfType(ENCHANT_LEVEL_TAG, 3)) return 0;
+        int v = tag.getInt(ENCHANT_LEVEL_TAG);
+        return Math.max(0, v);
+    }
+
+    /** Retourne le tier-lock du livre (ex: "pioche_jaspe"), ou null si pas de lock. */
+    public static String getEnchantTier(ItemStack book) {
+        NBTTagCompound tag = tagOf(book);
+        if (tag == null || !tag.hasKeyOfType(ENCHANT_TIER_TAG, 8)) return null;
+        String v = tag.getString(ENCHANT_TIER_TAG);
+        return (v == null || v.isEmpty()) ? null : v;
+    }
+
+    // ----- compatibilite enclume -----
+
+    /**
+     * Retourne true si le livre peut etre applique a la pioche :
+     *   - les deux items ont un tag NBT non vide
+     *   - le livre porte sparrowmc-enchant=minage_rapide et un niveau >= 1
+     *   - le tier-lock du livre correspond au sparrowmc-item de la pioche
+     *
+     * Ne valide PAS le coup XP, les permissions, ou l'etat du livre (hide/reveal) :
+     * c'est au plugin appelant de le faire avant d'appeler cette methode.
+     */
+    public static boolean isCompatible(ItemStack book, ItemStack pickaxe) {
+        if (book == null || pickaxe == null) return false;
+
+        NBTTagCompound bookTag = tagOf(book);
+        NBTTagCompound pickTag = tagOf(pickaxe);
+        if (bookTag == null || pickTag == null) return false;
+
+        // livre : doit etre un enchant minage_rapide avec niveau >= 1
+        String enchantId = bookTag.hasKeyOfType(ENCHANT_TAG, 8) ? bookTag.getString(ENCHANT_TAG) : null;
+        if (!ENCHANT_MINAGE_RAPIDE.equals(enchantId)) return false;
+
+        int level = bookTag.hasKeyOfType(ENCHANT_LEVEL_TAG, 3) ? bookTag.getInt(ENCHANT_LEVEL_TAG) : 0;
+        if (level < 1) return false;
+
+        // tier-lock obligatoire pour "minage_rapide"
+        String requiredTier = bookTag.hasKeyOfType(ENCHANT_TIER_TAG, 8) ? bookTag.getString(ENCHANT_TIER_TAG) : null;
+        if (requiredTier == null || requiredTier.isEmpty()) return false;
+
+        String pickaxeId = pickTag.hasKeyOfType(ITEM_TAG, 8) ? pickTag.getString(ITEM_TAG) : null;
+        if (pickaxeId == null || pickaxeId.isEmpty()) return false;
+
+        return requiredTier.equals(pickaxeId);
+    }
+
+    /**
+     * Retourne le niveau qui sera ecrit dans sparrowmc-mining-speed si la combinaison
+     * est appliquee, ou -1 si incompatible.
+     *
+     * Le plugin reste responsable de l'ecriture effective du tag NBT et de la consommation
+     * du livre / XP.
+     */
+    public static int getResultLevel(ItemStack book, ItemStack pickaxe) {
+        if (!isCompatible(book, pickaxe)) return -1;
+        return getEnchantLevel(book);
+    }
+}
