     private void sendUsage(CommandSender sender) {
         sender.sendMessage(ChatColor.GOLD + "/khope mining debug on|off|status|sim <MATERIAL>");
         sender.sendMessage(ChatColor.GOLD + "/khope mining reload");
+        sender.sendMessage(ChatColor.GOLD + "/khope mining give <joueur> <profil> [mr_level]");
+        sender.sendMessage(ChatColor.GOLD + "/khope mining give <joueur> book <tier> [level]");
+    }
+
+    // ---- /khope mining give ----
+
+    private boolean handleGive(CommandSender sender, String[] args) {
+        // /khope mining give <joueur> <profile_id> [mr_level]
+        // /khope mining give <joueur> book <tier> [level]
+        if (args.length < 4) {
+            sender.sendMessage(ChatColor.RED + "Usage : /khope mining give <joueur> <profil|book> [args...]");
+            return true;
+        }
+        Player target = org.bukkit.Bukkit.getPlayerExact(args[2]);
+        if (target == null) {
+            sender.sendMessage(ChatColor.RED + "Joueur introuvable : " + args[2]);
+            return true;
+        }
+
+        // forme livre : /khope mining give <joueur> book <tier> [level]
+        if ("book".equalsIgnoreCase(args[3])) {
+            if (args.length < 5) {
+                sender.sendMessage(ChatColor.RED + "Usage : /khope mining give <joueur> book <tier> [level]");
+                return true;
+            }
+            String tier = args[4].toLowerCase();
+            SparrowMiningConfig cfg = SparrowMiningConfig.get();
+            if (cfg == null || cfg.customMiningProfiles == null || !cfg.customMiningProfiles.containsKey(tier)) {
+                sender.sendMessage(ChatColor.RED + "Tier inconnu : " + tier);
+                return true;
+            }
+            int level = 1;
+            if (args.length >= 6) {
+                try { level = Math.max(1, Integer.parseInt(args[5])); }
+                catch (NumberFormatException e) {
+                    sender.sendMessage(ChatColor.RED + "Niveau invalide : " + args[5]);
+                    return true;
+                }
+            }
+            giveMinageRapideBook(target, tier, level);
+            sender.sendMessage(ChatColor.GREEN + "[KHOPE] Livre Minage Rapide " + tier + " niveau " + level
+                    + " donne a " + target.getName());
+            return true;
+        }
+
+        // forme pioche : /khope mining give <joueur> <profile_id> [mr_level]
+        String profileId = args[3].toLowerCase();
+        SparrowMiningConfig cfg = SparrowMiningConfig.get();
+        if (cfg == null || cfg.customMiningProfiles == null || !cfg.customMiningProfiles.containsKey(profileId)) {
+            sender.sendMessage(ChatColor.RED + "Profil inconnu : " + profileId
+                    + " (voir customMiningProfiles dans sparrow-mining.yml)");
+            return true;
+        }
+        int mrLevel = 0;
+        if (args.length >= 5) {
+            try { mrLevel = Math.max(0, Integer.parseInt(args[4])); }
+            catch (NumberFormatException e) {
+                sender.sendMessage(ChatColor.RED + "Niveau invalide : " + args[4]);
+                return true;
+            }
+        }
+        givePickaxe(target, profileId, mrLevel);
+        sender.sendMessage(ChatColor.GREEN + "[KHOPE] Pioche " + profileId
+                + (mrLevel > 0 ? " + MinageRapide " + mrLevel : "")
+                + " donnee a " + target.getName());
+        return true;
+    }
+
+    private void givePickaxe(Player target, String profileId, int mrLevel) {
+        net.minecraft.server.ItemStack nms = new net.minecraft.server.ItemStack(
+                net.minecraft.server.Items.DIAMOND_PICKAXE, 1, 0);
+        net.minecraft.server.NBTTagCompound tag = new net.minecraft.server.NBTTagCompound();
+        tag.setString(com.hpfxd.pandaspigot.util.SparrowItem.CUSTOM_ID_KEY, profileId);
+        if (mrLevel > 0) {
+            tag.setInt(com.hpfxd.pandaspigot.util.SparrowItem.MINING_SPEED_KEY, mrLevel);
+        }
+        // display name lisible (cosmetique)
+        net.minecraft.server.NBTTagCompound display = new net.minecraft.server.NBTTagCompound();
+        display.setString("Name", ChatColor.AQUA + prettifyId(profileId)
+                + (mrLevel > 0 ? ChatColor.GRAY + " [MR " + mrLevel + "]" : ""));
+        tag.set("display", display);
+        nms.setTag(tag);
+
+        org.bukkit.inventory.ItemStack bukkit = org.bukkit.craftbukkit.inventory.CraftItemStack.asBukkitCopy(nms);
+        target.getInventory().addItem(bukkit);
+    }
+
+    private void giveMinageRapideBook(Player target, String tier, int level) {
+        net.minecraft.server.ItemStack nms = new net.minecraft.server.ItemStack(
+                net.minecraft.server.Items.BOOK, 1, 0);
+        net.minecraft.server.NBTTagCompound tag = new net.minecraft.server.NBTTagCompound();
+        tag.setString(com.hpfxd.pandaspigot.api.SparrowAnvilAPI.ENCHANT_TAG,
+                com.hpfxd.pandaspigot.api.SparrowAnvilAPI.ENCHANT_MINAGE_RAPIDE);
+        tag.setInt(com.hpfxd.pandaspigot.api.SparrowAnvilAPI.ENCHANT_LEVEL_TAG, level);
+        tag.setString(com.hpfxd.pandaspigot.api.SparrowAnvilAPI.ENCHANT_TIER_TAG, tier);
+        net.minecraft.server.NBTTagCompound display = new net.minecraft.server.NBTTagCompound();
+        display.setString("Name", ChatColor.LIGHT_PURPLE + "Livre Minage Rapide " + romanLevel(level));
+        net.minecraft.server.NBTTagList lore = new net.minecraft.server.NBTTagList();
+        lore.add(new net.minecraft.server.NBTTagString(ChatColor.GRAY + "Compatible : " + ChatColor.AQUA + prettifyId(tier)));
+        lore.add(new net.minecraft.server.NBTTagString(ChatColor.DARK_GRAY + "A appliquer a l'enclume."));
+        display.set("Lore", lore);
+        tag.set("display", display);
+        nms.setTag(tag);
+
+        org.bukkit.inventory.ItemStack bukkit = org.bukkit.craftbukkit.inventory.CraftItemStack.asBukkitCopy(nms);
+        target.getInventory().addItem(bukkit);
+    }
+
+    private static String prettifyId(String id) {
+        if (id == null || id.isEmpty()) return "?";
+        StringBuilder sb = new StringBuilder(id.length());
+        boolean upper = true;
+        for (int i = 0; i < id.length(); i++) {
+            char c = id.charAt(i);
+            if (c == '_' || c == '-') { sb.append(' '); upper = true; continue; }
+            sb.append(upper ? Character.toUpperCase(c) : c);
+            upper = false;
+        }
+        return sb.toString();
+    }
+
+    private static String romanLevel(int n) {
+        switch (n) {
+            case 1: return "I";
+            case 2: return "II";
+            case 3: return "III";
+            case 4: return "IV";
+            case 5: return "V";
+            default: return Integer.toString(n);
+        }
     }
 
     @Override
     public List<String> tabComplete(CommandSender sender, String alias, String[] args) {
         if (!sender.isOp()) return java.util.Collections.emptyList();
         if (args.length == 1) return Arrays.asList("mining");
-        if (args.length == 2) return Arrays.asList("debug", "reload");
+        if (args.length == 2) return Arrays.asList("debug", "reload", "give");
         if (args.length == 3 && "debug".equalsIgnoreCase(args[1])) {
             return Arrays.asList("on", "off", "status", "sim");
         }
+        if ("give".equalsIgnoreCase(args[1])) {
+            if (args.length == 3) {
+                java.util.List<String> names = new java.util.ArrayList<>();
+                for (Player p : org.bukkit.Bukkit.getOnlinePlayers()) names.add(p.getName());
+                return names;
+            }
+            if (args.length == 4) {
+                java.util.List<String> ids = new java.util.ArrayList<>();
+                SparrowMiningConfig cfg = SparrowMiningConfig.get();
+                if (cfg != null && cfg.customMiningProfiles != null) ids.addAll(cfg.customMiningProfiles.keySet());
+                ids.add("book");
+                return ids;
+            }
+            if (args.length == 5 && "book".equalsIgnoreCase(args[3])) {
+                java.util.List<String> ids = new java.util.ArrayList<>();
+                SparrowMiningConfig cfg = SparrowMiningConfig.get();
+                if (cfg != null && cfg.customMiningProfiles != null) ids.addAll(cfg.customMiningProfiles.keySet());
+                return ids;
+            }
+            if (args.length == 5) return Arrays.asList("0", "1");
+            if (args.length == 6 && "book".equalsIgnoreCase(args[3])) return Arrays.asList("1");
+        }
         return java.util.Collections.emptyList();
     }
 }
