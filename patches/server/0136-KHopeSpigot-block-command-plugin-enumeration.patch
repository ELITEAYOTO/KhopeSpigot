diff --git a/src/test/java/net/minecraft/server/PlayerConnectionCommandCompletionTest.java b/src/test/java/net/minecraft/server/PlayerConnectionCommandCompletionTest.java
new file mode 100644
index 000000000..58135cdf7
--- /dev/null
+++ b/src/test/java/net/minecraft/server/PlayerConnectionCommandCompletionTest.java
@@ -0,0 +1,74 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import org.junit.Test;
+
+public class PlayerConnectionCommandCompletionTest {
+
+    @Test
+    public void removesPluginNamespaceFromRootCompletion() {
+        List<String> result = PlayerConnection.sanitizeCommandCompletions(
+                false, "/", Arrays.asList("/jobs", "/kcraft:kcraft", "/bukkit:help"));
+
+        assertEquals(Arrays.asList("/jobs"), result);
+    }
+
+    @Test
+    public void bypassPreservesDiagnosticNamespaces() {
+        List<String> input = Arrays.asList("/jobs", "/kcraft:kcraft");
+
+        assertEquals(input, PlayerConnection.sanitizeCommandCompletions(
+                true, "/", input));
+    }
+
+    @Test
+    public void doesNotStripNamespacedArgumentValues() {
+        List<String> input = Arrays.asList("minecraft:stone", "volkaria:azurite");
+
+        assertEquals(input, PlayerConnection.sanitizeCommandCompletions(
+                false, "/give Player ", input));
+    }
+
+    @Test
+    public void handlesNullCompletionListAsEmpty() {
+        assertEquals(0, PlayerConnection.sanitizeCommandCompletions(
+                false, "/", null).size());
+    }
+
+    @Test
+    public void rootCompletionRechecksActualCommandPermission() {
+        final Set<String> authorized = new HashSet<>(
+                Arrays.asList("jobs", "/cancel"));
+        List<String> result = PlayerConnection.filterAuthorizedRootCommandCompletions(
+                false, "/", Arrays.asList("/jobs", "/ban", "//cancel"),
+                authorized::contains);
+
+        assertEquals(Arrays.asList("/jobs", "//cancel"), result);
+    }
+
+    @Test
+    public void permissionFilterDoesNotTouchArgumentCompletion() {
+        List<String> input = Arrays.asList("PlayerOne", "PlayerTwo");
+
+        assertEquals(input, PlayerConnection.filterAuthorizedRootCommandCompletions(
+                false, "/msg ", input, label -> false));
+    }
+
+    @Test
+    public void recognizesHelpAliasesAndNamespacesCaseInsensitively() {
+        assertEquals(true, PlayerConnection.isSensitiveHelpCompletionRequest("/? "));
+        assertEquals(true, PlayerConnection.isSensitiveHelpCompletionRequest("/HELP "));
+        assertEquals(true, PlayerConnection.isSensitiveHelpCompletionRequest(
+                "/bukkit:help topic"));
+        assertEquals(true, PlayerConnection.isSensitiveHelpCompletionRequest(
+                "/minecraft:? "));
+        assertEquals(false, PlayerConnection.isSensitiveHelpCompletionRequest("/jobs "));
+        assertEquals(false, PlayerConnection.isSensitiveHelpCompletionRequest("help "));
+    }
+}
