From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: KHopeSpigot <noreply@localhost>
Date: Tue, 28 Jul 2026 13:31:00 +0200
Subject: [PATCH] KHopeSpigot: configurable player command allowlist

Hide every root command from non-bypass players by default and expose only
labels explicitly listed in spigot.yml. Keep command execution permission
handling unchanged, retain argument completion for visible commands and let
pandaspigot.command-enumeration.bypass preserve the complete diagnostic view.

diff --git a/src/main/java/org/spigotmc/SpigotConfig.java b/src/main/java/org/spigotmc/SpigotConfig.java
--- a/src/main/java/org/spigotmc/SpigotConfig.java
+++ b/src/main/java/org/spigotmc/SpigotConfig.java
@@ -7,9 +7,12 @@ import java.lang.reflect.InvocationTargetException;
 import java.lang.reflect.Method;
 import java.lang.reflect.Modifier;
 import java.util.Arrays;
+import java.util.Collections;
 import java.util.HashMap;
 import java.util.HashSet;
+import java.util.LinkedHashSet;
 import java.util.List;
+import java.util.Locale;
 import java.util.Map;
 import java.util.Set;
 import java.util.concurrent.TimeUnit;
@@ -190,6 +193,42 @@ public class SpigotConfig
         tabComplete = getInt( "commands.tab-complete", 0 );
     }
 
+    public static boolean playerCommandVisibilityEnabled;
+    public static Set<String> playerCommandVisibilityAllowlist =
+            Collections.emptySet();
+    private static void playerCommandVisibility()
+    {
+        playerCommandVisibilityEnabled = getBoolean(
+                "commands.player-command-visibility.enabled", true );
+        List configured = getList(
+                "commands.player-command-visibility.allowlist",
+                Collections.emptyList() );
+        Set<String> normalized = new LinkedHashSet<String>();
+        for ( Object entry : configured )
+        {
+            if ( entry == null )
+            {
+                continue;
+            }
+            String label = String.valueOf( entry ).trim().toLowerCase( Locale.ROOT );
+            while ( label.startsWith( "/" ) )
+            {
+                label = label.substring( 1 );
+            }
+            int separator = label.indexOf( ' ' );
+            if ( separator >= 0 )
+            {
+                label = label.substring( 0, separator );
+            }
+            if ( !label.isEmpty() && label.indexOf( ':' ) < 0 )
+            {
+                normalized.add( label );
+            }
+        }
+        playerCommandVisibilityAllowlist =
+                Collections.unmodifiableSet( normalized );
+    }
+
     public static String whitelistMessage;
     public static String unknownCommandMessage;
     public static String serverFullMessage;
