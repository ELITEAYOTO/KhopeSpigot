+    static boolean isAllowlistedCommandRequest(
+            String buffer, java.util.Set<String> allowlist) {
+        if (buffer == null || !buffer.startsWith("/")) {
+            return true;
+        }
+        String command = buffer.substring(1);
+        int whitespace = command.indexOf(' ');
+        String label = (whitespace < 0 ? command : command.substring(0, whitespace))
+                .toLowerCase(java.util.Locale.ROOT);
+        if (label.indexOf(':') >= 0) {
+            return false;
+        }
+        if (whitespace >= 0) {
+            return allowlist != null && allowlist.contains(label);
+        }
+        if (label.isEmpty()) {
+            return true;
+        }
+        if (allowlist != null) {
+            for (String allowed : allowlist) {
+                if (allowed.startsWith(label)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    static java.util.List<String> filterAllowlistedRootCommandCompletions(
+            boolean enumerationBypass, String buffer,
+            java.util.List<String> completions, java.util.Set<String> allowlist) {
+        if (enumerationBypass || buffer == null || !buffer.startsWith("/")
+                || buffer.indexOf(' ') >= 0 || completions == null
+                || completions.isEmpty()) {
+            return completions == null
+                    ? com.google.common.collect.ImmutableList.<String>of()
+                    : completions;
+        }
+
+        java.util.List<String> visible =
+                new java.util.ArrayList<>(completions.size());
+        for (String completion : completions) {
+            if (completion == null) {
+                continue;
+            }
+            String label = completion.startsWith("/")
+                    ? completion.substring(1) : completion;
+            int whitespace = label.indexOf(' ');
+            if (whitespace >= 0) {
+                label = label.substring(0, whitespace);
+            }
+            label = label.toLowerCase(java.util.Locale.ROOT);
+            if (label.indexOf(':') < 0 && allowlist != null
+                    && allowlist.contains(label)) {
+                visible.add(completion);
+            }
+        }
+        return visible;
+    }
+
