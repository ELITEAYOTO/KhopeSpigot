diff --git a/src/test/java/net/minecraft/server/PlayerConnectionCommandCompletionTest.java b/src/test/java/net/minecraft/server/PlayerConnectionCommandCompletionTest.java
--- a/src/test/java/net/minecraft/server/PlayerConnectionCommandCompletionTest.java
+++ b/src/test/java/net/minecraft/server/PlayerConnectionCommandCompletionTest.java
@@ -60,6 +60,72 @@ public class PlayerConnectionCommandCompletionTest {
                 false, "/msg ", input, label -> false));
     }
 
+    @Test
+    public void configurableAllowlistHidesEveryOtherRootCommand() {
+        Set<String> allowlist = new HashSet<>(
+                Arrays.asList("jobs", "shop", "f"));
+        List<String> result =
+                PlayerConnection.filterAllowlistedRootCommandCompletions(
+                    false, "/", Arrays.asList(
+                        "/jobs", "/ban", "/shop", "/f", "/minecraft:help"),
+                    allowlist);
+
+        assertEquals(Arrays.asList("/jobs", "/shop", "/f"), result);
+    }
+
+    @Test
+    public void bypassKeepsEveryRootSuggestion() {
+        List<String> input = Arrays.asList("/jobs", "/ban", "/bukkit:plugins");
+
+        assertEquals(input,
+                PlayerConnection.filterAllowlistedRootCommandCompletions(
+                    true, "/", input, new HashSet<String>()));
+    }
+
+    @Test
+    public void requestGateAllowsOnlyConfiguredRootsAndTheirPrefixes() {
+        Set<String> allowlist = new HashSet<>(
+                Arrays.asList("jobs", "shop"));
+
+        assertEquals(true, PlayerConnection.isAllowlistedCommandRequest(
+                "/", allowlist));
+        assertEquals(true, PlayerConnection.isAllowlistedCommandRequest(
+                "/jo", allowlist));
+        assertEquals(true, PlayerConnection.isAllowlistedCommandRequest(
+                "/jobs list", allowlist));
+        assertEquals(false, PlayerConnection.isAllowlistedCommandRequest(
+                "/ban Player", allowlist));
+        assertEquals(false, PlayerConnection.isAllowlistedCommandRequest(
+                "/bukkit:help ", allowlist));
+        assertEquals(true, PlayerConnection.isAllowlistedCommandRequest(
+                "hello", allowlist));
+    }
+
+    @Test
+    public void emptyAllowlistHidesAllRootCommandRequests() {
+        Set<String> allowlist = new HashSet<>();
+
+        assertEquals(true, PlayerConnection.isAllowlistedCommandRequest(
+                "/", allowlist));
+        assertEquals(false, PlayerConnection.isAllowlistedCommandRequest(
+                "/j", allowlist));
+        assertEquals(false, PlayerConnection.isAllowlistedCommandRequest(
+                "/jobs ", allowlist));
+        assertEquals(0,
+                PlayerConnection.filterAllowlistedRootCommandCompletions(
+                    false, "/", Arrays.asList("/jobs"), allowlist).size());
+    }
+
+    @Test
+    public void allowlistDoesNotChangeArgumentsOfVisibleCommands() {
+        List<String> input = Arrays.asList("PlayerOne", "PlayerTwo");
+
+        assertEquals(input,
+                PlayerConnection.filterAllowlistedRootCommandCompletions(
+                    false, "/msg ", input,
+                    new HashSet<>(Arrays.asList("msg"))));
+    }
+
     @Test
     public void recognizesHelpAliasesAndNamespacesCaseInsensitively() {
         assertEquals(true, PlayerConnection.isSensitiveHelpCompletionRequest("/? "));
