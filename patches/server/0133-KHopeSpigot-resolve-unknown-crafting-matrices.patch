From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: KHopeSpigot <fork@localhost>
Date: Mon, 20 Jul 2026 19:11:00 +0200
Subject: [PATCH] KHopeSpigot: resolve and trace unknown crafting matrices

Give custom crafting plugins an isolated preparation hook when the vanilla
CraftingManager has no matching recipe. Existing recipes and the global
registry remain untouched. Targeted traces follow a recalculation through the
manager, event factory, workbench result and click safety path.

diff --git a/src/main/java/com/hpfxd/pandaspigot/util/KCraftDebugTrace.java b/src/main/java/com/hpfxd/pandaspigot/util/KCraftDebugTrace.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/com/hpfxd/pandaspigot/util/KCraftDebugTrace.java
@@ -0,0 +1,114 @@
+package com.hpfxd.pandaspigot.util;
+
+import java.util.Collections;
+import java.util.Map;
+import java.util.WeakHashMap;
+import java.util.concurrent.atomic.AtomicLong;
+
+import net.minecraft.server.IInventory;
+import net.minecraft.server.InventoryCrafting;
+import net.minecraft.server.Item;
+import net.minecraft.server.ItemStack;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.World;
+
+import org.bukkit.entity.Player;
+import org.bukkit.metadata.MetadataValue;
+
+/** Targeted runtime trace shared by the KHopeSpigot crafting stages. */
+public final class KCraftDebugTrace {
+    public static final String METADATA = "kcraft-vanilla-debug";
+
+    private static final AtomicLong IDS = new AtomicLong();
+    private static final Map<InventoryCrafting, Trace> TRACES =
+        Collections.synchronizedMap(new WeakHashMap<InventoryCrafting, Trace>());
+
+    private KCraftDebugTrace() {
+    }
+
+    public static long begin(InventoryCrafting matrix, World world) {
+        Player player = player(matrix);
+        if (!enabled(player)) {
+            TRACES.remove(matrix);
+            return 0L;
+        }
+        Trace trace = new Trace(IDS.incrementAndGet(), player.getName());
+        TRACES.put(matrix, trace);
+        log(trace, "A", "CraftingManager.craft entree monde="
+            + (world == null || world.getWorld() == null ? "?" : world.getWorld().getName())
+            + " taille=" + matrix.getSize() + " matrice=" + describeMatrix(matrix));
+        return trace.id;
+    }
+
+    public static long currentId(InventoryCrafting matrix) {
+        Trace trace = TRACES.get(matrix);
+        return trace == null ? 0L : trace.id;
+    }
+
+    public static void log(InventoryCrafting matrix, String stage, String message) {
+        Trace trace = TRACES.get(matrix);
+        if (trace != null) log(trace, stage, message);
+    }
+
+    public static void logNextTick(final InventoryCrafting matrix,
+                                   final IInventory resultInventory) {
+        final Trace trace = TRACES.get(matrix);
+        if (trace == null) return;
+        MinecraftServer server = MinecraftServer.getServer();
+        if (server == null) return;
+        server.processQueue.add(new Runnable() {
+            @Override public void run() {
+                ItemStack result = resultInventory == null ? null : resultInventory.getItem(0);
+                log(trace, "D+1", "InventoryCraftResult slot0 tick suivant=" + describe(result));
+            }
+        });
+    }
+
+    public static String describe(ItemStack item) {
+        if (item == null) return "VIDE";
+        StringBuilder out = new StringBuilder()
+            .append(Item.getId(item.getItem())).append(':').append(item.getData())
+            .append(" x").append(item.count);
+        if (item.hasTag()) out.append(" nbt=").append(item.getTag());
+        return out.toString();
+    }
+
+    private static String describeMatrix(InventoryCrafting matrix) {
+        StringBuilder out = new StringBuilder();
+        for (int slot = 0; slot < matrix.getSize(); slot++) {
+            if (slot > 0) out.append(' ');
+            out.append('[').append(slot).append('=').append(describe(matrix.getItem(slot))).append(']');
+        }
+        return out.toString();
+    }
+
+    private static Player player(InventoryCrafting matrix) {
+        if (matrix == null || !(matrix.getOwner() instanceof Player)) return null;
+        return (Player) matrix.getOwner();
+    }
+
+    private static boolean enabled(Player player) {
+        if (player == null || !player.hasMetadata(METADATA)) return false;
+        long now = System.currentTimeMillis();
+        for (MetadataValue value : player.getMetadata(METADATA)) {
+            long expiresAt = value.asLong();
+            if (expiresAt <= 0L || expiresAt > now) return true;
+        }
+        return false;
+    }
+
+    private static void log(Trace trace, String stage, String message) {
+        MinecraftServer.LOGGER.info("[KHope-CraftDebug][{}][#{}][{}] {}",
+            trace.playerName, trace.id, stage, message);
+    }
+
+    private static final class Trace {
+        private final long id;
+        private final String playerName;
+
+        private Trace(long id, String playerName) {
+            this.id = id;
+            this.playerName = playerName;
+        }
+    }
+}
