+    // KHopeSpigot start - custom crafting extension without global bridge recipes
+    public static ItemStack callPrepareUnknownCraftEvent(InventoryCrafting matrix, InventoryView lastCraftView) {
+        int listenerCount = PrepareUnknownCraftEvent.getHandlerList().getRegisteredListeners().length;
+        KCraftDebugTrace.log(matrix, "B", "entree CraftEventFactory view="
+            + (lastCraftView == null ? "<null>" : lastCraftView.getClass().getName())
+            + " joueur=" + (lastCraftView == null ? "<null>" : lastCraftView.getPlayer().getName())
+            + " listeners=" + listenerCount + " resultat-avant="
+            + KCraftDebugTrace.describe(matrix.resultInventory.getItem(0)));
+        if (listenerCount == 0) {
+            KCraftDebugTrace.log(matrix, "B", "aucun listener; retour NMS=VIDE");
+            return null;
+        }
+        CraftInventoryCrafting inventory = new CraftInventoryCrafting(matrix, matrix.resultInventory);
+        inventory.setResult(null);
+
+        PrepareUnknownCraftEvent event = new PrepareUnknownCraftEvent(
+            inventory, lastCraftView, KCraftDebugTrace.currentId(matrix));
+        Bukkit.getPluginManager().callEvent(event);
+
+        org.bukkit.inventory.ItemStack bitem = event.getInventory().getResult();
+        KCraftDebugTrace.log(matrix, "B", "apres evenement resultat-Bukkit="
+            + (bitem == null ? "VIDE" : bitem.getType() + ":" + bitem.getDurability()
+                + " x" + bitem.getAmount()));
+        ItemStack converted = CraftItemStack.asNMSCopy(bitem);
+        KCraftDebugTrace.log(matrix, "B", "conversion Bukkit->NMS / retour="
+            + KCraftDebugTrace.describe(converted));
+        return converted;
+    }
+    // KHopeSpigot end
+
