--- /dev/null
+++ b/src/main/java/com/hpfxd/pandaspigot/config/SparrowSecurityConfig.java
@@ -0,0 +1,106 @@
+package com.hpfxd.pandaspigot.config;
+
+import java.io.File;
+import java.util.logging.Logger;
+
+import org.spongepowered.configurate.CommentedConfigurationNode;
+import org.spongepowered.configurate.objectmapping.ConfigSerializable;
+import org.spongepowered.configurate.objectmapping.ObjectMapper;
+import org.spongepowered.configurate.objectmapping.meta.Comment;
+import org.spongepowered.configurate.util.MapFactories;
+import org.spongepowered.configurate.util.NamingSchemes;
+
+import com.google.common.base.Throwables;
+import com.hpfxd.configurate.eoyaml.EOYamlConfigurationLoader;
+
+/**
+ * SparrowMC security configuration — loaded from sparrow-security.yml.
+ *
+ * Covers:
+ *   - Map: limiter le taux de rendu des cartes tenues en main (anti-lag).
+ *   - Sign: intervalle minimum entre deux mises a jour d'enseigne par joueur (anti-spam).
+ *
+ * Tous les defauts reproduisent le comportement vanilla/Spigot.
+ */
+@ConfigSerializable
+@SuppressWarnings({"FieldCanBeLocal", "FieldMayBeFinal"})
+public class SparrowSecurityConfig {
+
+    private static final Logger LOGGER = Logger.getLogger("Minecraft");
+    private static SparrowSecurityConfig config;
+
+    // --- Champs statiques caches pour la performance par tick ---
+
+    /** Intervalle en ticks entre deux rendus de carte tenue en main. 1 = vanilla. */
+    public static int mapUpdateInterval = 1;
+
+    /** Intervalle minimum en ticks entre deux mises a jour d'enseigne par joueur. 0 = desactive. */
+    public static int signUpdateIntervalTicks = 0;
+
+    // --- Initialisation ---
+
+    public static void init(File file) {
+        EOYamlConfigurationLoader loader = EOYamlConfigurationLoader.builder()
+                .file(file)
+                .defaultOptions(o -> o
+                        .header("SparrowMC security configuration.\n" +
+                                "Tous les defauts reproduisent le comportement vanilla/Spigot (safe a deployer tel quel).\n" +
+                                "\n" +
+                                "map:\n" +
+                                "  updateInterval — interval en ticks entre deux rendus de carte tenue en main.\n" +
+                                "                   1 = vanilla (rendu chaque tick).\n" +
+                                "                   4 = recommande (rendu toutes les 200 ms, imperceptible).\n" +
+                                "\n" +
+                                "sign:\n" +
+                                "  updateIntervalTicks — intervalle minimum en ticks entre deux PacketPlayInUpdateSign\n" +
+                                "                        envoyes par le meme joueur.\n" +
+                                "                        0 = desactive (comportement vanilla).\n" +
+                                "                        20 = une mise a jour par seconde maximum.\n" +
+                                "                        Recommande pour eviter le spam d'enseigne: 5.")
+                        .mapFactory(MapFactories.insertionOrdered())
+                        .serializers(build -> build.registerAnnotatedObjects(ObjectMapper.factoryBuilder()
+                                .defaultNamingScheme(NamingSchemes.CAMEL_CASE)
+                                .build())))
+                .build();
+
+        try {
+            CommentedConfigurationNode root = loader.load();
+            config = root.get(SparrowSecurityConfig.class);
+            root.set(config);
+            loader.save(root);
+            cacheFields(config);
+            LOGGER.info("[SparrowSecurity] Configuration chargee depuis " + file.getName() + ".");
+        } catch (Exception e) {
+            throw Throwables.propagate(e);
+        }
+    }
+
+    private static void cacheFields(SparrowSecurityConfig cfg) {
+        mapUpdateInterval       = Math.max(1, cfg.map.updateInterval);
+        signUpdateIntervalTicks = Math.max(0, cfg.sign.updateIntervalTicks);
+    }
+
+    // --- Structure de configuration ---
+
+    @Comment("Map rendering settings")
+    public MapConfig map = new MapConfig();
+
+    @Comment("Sign update settings")
+    public SignConfig sign = new SignConfig();
+
+    // --- Classes internes ---
+
+    @ConfigSerializable
+    public static class MapConfig {
+        @Comment("Intervalle en ticks entre deux rendus de carte tenue en main.\n" +
+                 "1 = vanilla. 4 = recommande (reduit la charge CPU sans impact visuel).")
+        public int updateInterval = 1;
+    }
+
+    @ConfigSerializable
+    public static class SignConfig {
+        @Comment("Intervalle minimum en ticks entre deux paquets de mise a jour d'enseigne par joueur.\n" +
+                 "0 = desactive (vanilla). 5 = recommande. 20 = une mise a jour par seconde max.")
+        public int updateIntervalTicks = 0;
+    }
+}
