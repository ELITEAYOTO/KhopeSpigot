+    @Comment("Stage PlayerChunk subscriptions through a fair round-robin queue before they reach the generation queue.\n" +
+            "This keeps one teleporting/exploring player from filling the entire generation backlog ahead of everyone else.\n" +
+            "Chunks for each player remain nearest-first.")
+    public boolean fairPlayerChunkSubscriptions = true;
+
+    @Comment("Maximum PlayerChunk subscriptions admitted per world tick while fairness is enabled.\n" +
+            "This work is much cheaper than terrain generation; the generation queue still has its own separate budget.")
+    public int playerChunkSubscriptionMaxPerTick = 256;
+
+    @Comment("Maximum number of consecutive PlayerChunk subscriptions given to one player before rotating to another player.\n" +
+            "Lower values improve fairness when many players teleport/explore at once.")
+    public int playerChunkSubscriptionQuantum = 4;
+
     public boolean optimizeTntMovement = false; // May not fully emulate vanilla behavior
 
     public boolean optimizeLiquidExplosions = true; // This seems like a pretty sane default
