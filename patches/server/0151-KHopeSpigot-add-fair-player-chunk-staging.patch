+    // KHopeSpigot start - 0151 fair PlayerChunk subscription staging
+    private void queueKhopePlayerChunks(EntityPlayer player, List<ChunkCoordIntPair> chunks) {
+        if (chunks == null || chunks.isEmpty()) {
+            this.clearKhopePendingPlayerChunks(player);
+            return;
+        }
+
+        final ArrayDeque<ChunkCoordIntPair> pending =
+                new ArrayDeque<ChunkCoordIntPair>(chunks.size());
+
+        for (ChunkCoordIntPair pair : chunks) {
+            pending.add(pair);
+        }
+
+        this.khopePendingChunksByPlayer.put(player, pending);
+
+        if (this.khopeQueuedPlayers.add(player)) {
+            this.khopePendingPlayers.add(player);
+        }
+    }
+
+    private void clearKhopePendingPlayerChunks(EntityPlayer player) {
+        this.khopePendingChunksByPlayer.remove(player);
+        // The queue node is discarded lazily to keep repeated teleports O(1).
+        this.khopeQueuedPlayers.remove(player);
+    }
+
+    private boolean isKhopePlayerSubscribed(EntityPlayer player, int x, int z) {
+        final PlayerChunk playerChunk = this.a(x, z, false);
+        return playerChunk != null && playerChunk.b.contains(player);
+    }
+
+    private List<ChunkCoordIntPair> buildKhopeMissingView(EntityPlayer player) {
+        final int centerX = (int) player.locX >> 4;
+        final int centerZ = (int) player.locZ >> 4;
+        final int viewDistance = player.viewDistance;
+        final List<ChunkCoordIntPair> chunks =
+                new ArrayList<ChunkCoordIntPair>((viewDistance * 2 + 1) * (viewDistance * 2 + 1));
+
+        for (int x = centerX - viewDistance; x <= centerX + viewDistance; ++x) {
+            for (int z = centerZ - viewDistance; z <= centerZ + viewDistance; ++z) {
+                if (!this.isKhopePlayerSubscribed(player, x, z)) {
+                    chunks.add(new ChunkCoordIntPair(x, z));
+                }
+            }
+        }
+
+        Collections.sort(chunks, new ChunkCoordComparator(player));
+        return chunks;
+    }
+
+    private void applyOrQueueKhopePlayerChunks(EntityPlayer player, List<ChunkCoordIntPair> chunks) {
+        if (!this.world.pandaSpigotConfig.fairPlayerChunkSubscriptions) {
+            this.clearKhopePendingPlayerChunks(player);
+            for (ChunkCoordIntPair pair : chunks) {
+                this.a(pair.x, pair.z, true).a(player);
+            }
+            return;
+        }
+
+        this.queueKhopePlayerChunks(player, chunks);
+    }
+
+    private void processKhopePendingPlayerChunks() {
+        if (this.khopePendingPlayers.isEmpty()) {
+            return;
+        }
+
+        final com.hpfxd.pandaspigot.config.PandaSpigotWorldConfig config =
+                this.world.pandaSpigotConfig;
+        final boolean fairness = config.fairPlayerChunkSubscriptions;
+        final int maxPerTick = fairness
+                ? Math.max(1, config.playerChunkSubscriptionMaxPerTick)
+                : Integer.MAX_VALUE;
+        final int quantum = fairness
+                ? Math.max(1, config.playerChunkSubscriptionQuantum)
+                : Integer.MAX_VALUE;
+
+        int processed = 0;
+        int rotations = 0;
+        final int initialActivePlayers = Math.max(1, this.khopeQueuedPlayers.size());
+
+        while (processed < maxPerTick && !this.khopePendingPlayers.isEmpty()) {
+            final EntityPlayer player = this.khopePendingPlayers.poll();
+
+            if (!this.khopeQueuedPlayers.contains(player)) {
+                continue;
+            }
+
+            final ArrayDeque<ChunkCoordIntPair> pending =
+                    this.khopePendingChunksByPlayer.get(player);
+            if (pending == null || pending.isEmpty()) {
+                this.khopePendingChunksByPlayer.remove(player);
+                this.khopeQueuedPlayers.remove(player);
+                continue;
+            }
+
+            int playerProcessed = 0;
+            while (processed < maxPerTick && playerProcessed < quantum && !pending.isEmpty()) {
+                final ChunkCoordIntPair pair = pending.poll();
+
+                final int centerX = (int) player.locX >> 4;
+                final int centerZ = (int) player.locZ >> 4;
+                if (this.a(pair.x, pair.z, centerX, centerZ, player.viewDistance)
+                        && !this.isKhopePlayerSubscribed(player, pair.x, pair.z)) {
+                    this.a(pair.x, pair.z, true).a(player);
+                }
+
+                ++processed;
+                ++playerProcessed;
+            }
+
+            ++rotations;
+
+            if (pending.isEmpty()) {
+                this.khopePendingChunksByPlayer.remove(player);
+                this.khopeQueuedPlayers.remove(player);
+            } else {
+                this.khopePendingPlayers.add(player);
+            }
+
+            if (!fairness && rotations >= initialActivePlayers) {
+                break;
+            }
+        }
+
+        int totalPending = 0;
+        for (ArrayDeque<ChunkCoordIntPair> queue : this.khopePendingChunksByPlayer.values()) {
+            totalPending += queue.size();
+        }
+
+        com.hpfxd.pandaspigot.util.KhopePerformanceDiagnostics.recordPlayerChunkSubscriptionBudget(
+                processed,
+                this.khopeQueuedPlayers.size(),
+                totalPending);
+    }
+    // KHopeSpigot end
+
     public void addPlayer(EntityPlayer entityplayer) {
