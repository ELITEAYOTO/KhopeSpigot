                 if (random.nextInt((int) (world.growthOdds / world.spigotConfig.wheatModifier * (25.0F / f)) + 1) == 0) { // Spigot                    // CraftBukkit start
                     IBlockData data = iblockdata.set(AGE, Integer.valueOf(i + 1));
@@ -100,7 +115,17 @@ public class BlockCrops extends BlockPlant implements IBlockFragilePlantElement
     }
 
     public boolean f(World world, BlockPosition blockposition, IBlockData iblockdata) {
-        return (world.k(blockposition) >= 8 || world.i(blockposition)) && this.c(world.getType(blockposition.down()).getBlock());
+        // SparrowCrops - skip light survival check when requireLight is false for this crop
+        boolean requireLight;
+        if (this == Blocks.CARROTS) {
+            requireLight = com.hpfxd.pandaspigot.config.SparrowCropsConfig.carrotRequireLight;
+        } else if (this == Blocks.POTATOES) {
+            requireLight = com.hpfxd.pandaspigot.config.SparrowCropsConfig.potatoRequireLight;
+        } else {
+            requireLight = com.hpfxd.pandaspigot.config.SparrowCropsConfig.wheatRequireLight;
+        }
+        boolean lightOk = !requireLight || (world.k(blockposition) >= 8 || world.i(blockposition));
+        return lightOk && this.c(world.getType(blockposition.down()).getBlock());
     }
 
     protected Item l() {
