             this.s = this.tracker.locZ;
             this.isMoving = true;
             this.n = true;
-            this.scanPlayers(list);
+            this.scanKhopePlayers(list);
         }
 
         if (this.w != this.tracker.vehicle || this.tracker.vehicle != null && this.m % 60 == 0) {
@@ -451,6 +451,20 @@ public class EntityTrackerEntry {
         return entityplayer.u().getPlayerChunkMap().a(entityplayer, this.tracker.ae, this.tracker.ag);
     }
 
+    // KHopeSpigot start - 0164 chunk-watcher-aware tracker refresh
+    public void scanKhopePlayers(List<EntityHuman> list) {
+        // A non-server world should never own a server tracker entry, but keep
+        // the original global scan as a conservative fallback.
+        if (!(this.tracker.world instanceof WorldServer)) {
+            this.scanPlayers(list);
+            return;
+        }
+
+        ((WorldServer) this.tracker.world).getPlayerChunkMap()
+                .scanKhopeEntityTrackerPlayers(this, list);
+    }
+    // KHopeSpigot end
+
     public void scanPlayers(List<EntityHuman> list) {
         for (int i = 0; i < list.size(); ++i) {
             this.updatePlayer((EntityPlayer) list.get(i));
diff --git a/src/main/java/net/minecraft/server/PlayerChunkMap.java b/src/main/java/net/minecraft/server/PlayerChunkMap.java
index c872cb15f..d10199bcd 100644
--- a/src/main/java/net/minecraft/server/PlayerChunkMap.java
+++ b/src/main/java/net/minecraft/server/PlayerChunkMap.java
@@ -40,6 +40,11 @@ public class PlayerChunkMap {
             Collections.newSetFromMap(new IdentityHashMap<EntityPlayer, Boolean>());
     // KHopeSpigot end
 
+    // KHopeSpigot - 0164 reusable snapshot for EntityTrackerEntry viewer
+    // refreshes. Main-thread only; avoids allocating one list per moving entity.
+    private final ArrayList<EntityPlayer> khopeEntityTrackerViewerScratch =
+            new ArrayList<EntityPlayer>();
+
     public PlayerChunkMap(WorldServer worldserver, int viewDistance /* Spigot */) {
         this.world = worldserver;
         this.a(viewDistance); // Spigot
@@ -435,6 +440,97 @@ public class PlayerChunkMap {
         }
     }
 
+    // KHopeSpigot start - 0164 chunk-watcher-aware EntityTrackerEntry refresh
+    public void scanKhopeEntityTrackerPlayers(
+            EntityTrackerEntry entry,
+            List<EntityHuman> fallbackPlayers) {
+        final boolean captureScaling =
+                com.hpfxd.pandaspigot.util.KhopePerformanceDiagnostics
+                        .isJobsEnabledForCurrentTick();
+        final int legacyChecks = fallbackPlayers.size();
+
+        // attachedToPlayer explicitly bypasses normal chunk visibility in
+        // EntityTrackerEntry.updatePlayer(), so its candidate set really is
+        // the full player list.
+        if (entry.tracker.attachedToPlayer) {
+            entry.scanPlayers(fallbackPlayers);
+
+            if (captureScaling) {
+                com.hpfxd.pandaspigot.util.KhopePerformanceDiagnostics
+                        .recordEntityTrackerEntryRefresh(
+                                legacyChecks, 0, 0, 0, legacyChecks);
+            }
+            return;
+        }
+
+        final PlayerChunkMap.PlayerChunk playerChunk =
+                this.a(entry.tracker.ae, entry.tracker.ag, false);
+        final int reverseChecks = entry.trackedPlayers.size();
+        final int watcherChecks =
+                playerChunk == null ? 0 : playerChunk.b.size();
+        final long spatialChecks =
+                (long) reverseChecks + (long) watcherChecks;
+
+        // Keep the simple global loop unless the chunk-local candidate set is
+        // clearly smaller. This prevents regressions when most online players
+        // are concentrated in the same chunk.
+        if (spatialChecks * 2L >= (long) legacyChecks) {
+            entry.scanPlayers(fallbackPlayers);
+
+            if (captureScaling) {
+                com.hpfxd.pandaspigot.util.KhopePerformanceDiagnostics
+                        .recordEntityTrackerEntryRefresh(
+                                legacyChecks, 0, 0, 0, legacyChecks);
+            }
+            return;
+        }
+
+        final ArrayList<EntityPlayer> trackedScratch =
+                this.khopeEntityTrackerViewerScratch;
+        trackedScratch.clear();
+        trackedScratch.addAll(entry.trackedPlayers);
+
+        // Existing relations must be revisited so updatePlayer() can remove
+        // viewers that moved outside the entity's tracking range. Snapshotting
+        // is required because updatePlayer() may remove from trackedPlayers.
+        for (int i = 0, size = trackedScratch.size(); i < size; ++i) {
+            entry.updatePlayer(trackedScratch.get(i));
+        }
+
+        int candidateUpdates = 0;
+
+        if (playerChunk != null) {
+            final List<EntityPlayer> watchers = playerChunk.b;
+
+            for (int i = 0, size = watchers.size(); i < size; ++i) {
+                final EntityPlayer player = watchers.get(i);
+
+                if (player == entry.tracker
+                        || entry.trackedPlayers.contains(player)) {
+                    continue;
+                }
+
+                ++candidateUpdates;
+                // updatePlayer() preserves the original range, chunk-sent and
+                // vanish checks. PlayerChunk.b is only a candidate index.
+                entry.updatePlayer(player);
+            }
+        }
+
+        trackedScratch.clear();
+
+        if (captureScaling) {
+            com.hpfxd.pandaspigot.util.KhopePerformanceDiagnostics
+                    .recordEntityTrackerEntryRefresh(
+                            legacyChecks,
+                            reverseChecks,
+                            watcherChecks,
+                            candidateUpdates,
+                            0);
+        }
+    }
+    // KHopeSpigot end
+
     public boolean a(EntityPlayer entityplayer, int i, int j) {
         PlayerChunkMap.PlayerChunk playerchunkmap_playerchunk = this.a(i, j, false);
 
