From: Timothe <timothe.renou@gmail.com>
Date: Mon, 17 Aug 2026 15:43:59 +0200
Subject: [PATCH] KHopeSpigot: optimize entity tracker watcher refresh

---
 .../util/KhopePerformanceDiagnostics.java     | 82 +++++++++++++++-
 .../net/minecraft/server/EntityTracker.java   |  2 +-
 .../minecraft/server/EntityTrackerEntry.java  | 16 +++-
 .../net/minecraft/server/PlayerChunkMap.java  | 96 +++++++++++++++++++
 4 files changed, 193 insertions(+), 3 deletions(-)

diff --git a/src/main/java/com/hpfxd/pandaspigot/util/KhopePerformanceDiagnostics.java b/src/main/java/com/hpfxd/pandaspigot/util/KhopePerformanceDiagnostics.java
index 0b4ca25d6..fcfb5b8ae 100644
--- a/src/main/java/com/hpfxd/pandaspigot/util/KhopePerformanceDiagnostics.java
+++ b/src/main/java/com/hpfxd/pandaspigot/util/KhopePerformanceDiagnostics.java
@@ -246,6 +246,14 @@ public final class KhopePerformanceDiagnostics {
     private static long entityTrackerMovedCandidateUpdates;
     private static long entityTrackerMovedGlobalFallbackChecks;
 
+    // 0164 - moving/new EntityTrackerEntry viewer refresh diagnostics.
+    private static long entityTrackerEntryRefreshes;
+    private static long entityTrackerEntryLegacyChecks;
+    private static long entityTrackerEntryReverseChecks;
+    private static long entityTrackerEntryWatcherChecks;
+    private static long entityTrackerEntryCandidateUpdates;
+    private static long entityTrackerEntryGlobalFallbackChecks;
+
     // Current FutureTask context. Main-thread only while jobs tracing is active.
     private static boolean jobTraceActive;
     private static String currentJobCommand = "-";
@@ -584,6 +592,24 @@ public final class KhopePerformanceDiagnostics {
         entityTrackerMovedGlobalFallbackChecks += Math.max(0, globalFallbackChecks);
     }
 
+    public static void recordEntityTrackerEntryRefresh(
+            int legacyChecks,
+            int reverseChecks,
+            int watcherChecks,
+            int candidateUpdates,
+            int globalFallbackChecks) {
+        if (!jobsThisTick) {
+            return;
+        }
+
+        ++entityTrackerEntryRefreshes;
+        entityTrackerEntryLegacyChecks += Math.max(0, legacyChecks);
+        entityTrackerEntryReverseChecks += Math.max(0, reverseChecks);
+        entityTrackerEntryWatcherChecks += Math.max(0, watcherChecks);
+        entityTrackerEntryCandidateUpdates += Math.max(0, candidateUpdates);
+        entityTrackerEntryGlobalFallbackChecks += Math.max(0, globalFallbackChecks);
+    }
+
     public static void recordSection(int section, long nanos) {
         if (!detailThisTick
                 || section < 0
@@ -967,7 +993,9 @@ public final class KhopePerformanceDiagnostics {
                         + chunkIoCompletionMaxPending);
             }
 
-            if (entityTrackerTicks > 0L || entityTrackerChunkRefreshes > 0L) {
+            if (entityTrackerTicks > 0L
+                    || entityTrackerChunkRefreshes > 0L
+                    || entityTrackerEntryRefreshes > 0L) {
                 sender.sendMessage(ChatColor.GOLD + "--- EntityTracker scaling 0162 ---");
 
                 if (entityTrackerTicks > 0L) {
@@ -1023,6 +1051,51 @@ public final class KhopePerformanceDiagnostics {
                             + ")");
                 }
 
+                if (entityTrackerEntryRefreshes > 0L) {
+                    final long entryActualChecks =
+                            entityTrackerEntryReverseChecks
+                                    + entityTrackerEntryWatcherChecks
+                                    + entityTrackerEntryGlobalFallbackChecks;
+                    final long entryAvoidedChecks = Math.max(
+                            0L,
+                            entityTrackerEntryLegacyChecks - entryActualChecks);
+                    final double entryReduction =
+                            entityTrackerEntryLegacyChecks == 0L
+                                    ? 0.0D
+                                    : (100.0D * (double) entryAvoidedChecks
+                                            / (double) entityTrackerEntryLegacyChecks);
+
+                    sender.sendMessage(ChatColor.GRAY + "Entry refreshes 0164: "
+                            + ChatColor.YELLOW
+                            + entityTrackerEntryRefreshes
+                            + ChatColor.GRAY + " | legacy player checks: "
+                            + ChatColor.RED
+                            + entityTrackerEntryLegacyChecks);
+
+                    sender.sendMessage(ChatColor.GRAY + "Entry reverse checks: "
+                            + ChatColor.YELLOW
+                            + entityTrackerEntryReverseChecks
+                            + ChatColor.GRAY + " | chunk watcher checks: "
+                            + ChatColor.GREEN
+                            + entityTrackerEntryWatcherChecks
+                            + ChatColor.GRAY + " | candidate updates: "
+                            + ChatColor.YELLOW
+                            + entityTrackerEntryCandidateUpdates);
+
+                    sender.sendMessage(ChatColor.GRAY + "Entry adaptive global checks: "
+                            + ChatColor.YELLOW
+                            + entityTrackerEntryGlobalFallbackChecks
+                            + ChatColor.GRAY + " | estimated checks avoided: "
+                            + ChatColor.GREEN
+                            + entryAvoidedChecks
+                            + ChatColor.GRAY + " ("
+                            + ChatColor.GREEN
+                            + formatDouble(entryReduction)
+                            + "%"
+                            + ChatColor.GRAY
+                            + ")");
+                }
+
                 if (entityTrackerChunkRefreshes > 0L) {
                     final long avoidedChecks = Math.max(
                             0L,
@@ -1290,6 +1363,13 @@ public final class KhopePerformanceDiagnostics {
         entityTrackerMovedLocalEntityChecks = 0L;
         entityTrackerMovedCandidateUpdates = 0L;
         entityTrackerMovedGlobalFallbackChecks = 0L;
+
+        entityTrackerEntryRefreshes = 0L;
+        entityTrackerEntryLegacyChecks = 0L;
+        entityTrackerEntryReverseChecks = 0L;
+        entityTrackerEntryWatcherChecks = 0L;
+        entityTrackerEntryCandidateUpdates = 0L;
+        entityTrackerEntryGlobalFallbackChecks = 0L;
         jobTraceActive = false;
         currentJobCommand = "-";
         currentJobCommandNanos = 0L;
diff --git a/src/main/java/net/minecraft/server/EntityTracker.java b/src/main/java/net/minecraft/server/EntityTracker.java
index b9df41933..c3fed0e3f 100644
--- a/src/main/java/net/minecraft/server/EntityTracker.java
+++ b/src/main/java/net/minecraft/server/EntityTracker.java
@@ -119,7 +119,7 @@ public class EntityTracker {
 
             this.c.add(entitytrackerentry);
             this.trackedEntities.a(entity.getId(), entitytrackerentry);
-            entitytrackerentry.scanPlayers(this.world.players);
