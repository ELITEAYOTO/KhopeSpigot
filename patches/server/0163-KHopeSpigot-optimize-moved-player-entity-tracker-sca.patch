@@ -321,6 +321,7 @@ public class EntityTrackerEntry {
             EntityPlayer entityplayer = (EntityPlayer) iterator.next();
 
             entityplayer.d(this.tracker);
+            entityplayer.khopeTrackedEntries.remove(this);
         }
 
     }
@@ -329,6 +330,7 @@ public class EntityTrackerEntry {
         if (this.trackedPlayers.contains(entityplayer)) {
             entityplayer.d(this.tracker);
             this.trackedPlayers.remove(entityplayer);
+            entityplayer.khopeTrackedEntries.remove(this);
         }
 
     }
@@ -349,6 +351,7 @@ public class EntityTrackerEntry {
                     entityplayer.removeQueue.remove(Integer.valueOf(this.tracker.getId()));
                     // CraftBukkit end
                     this.trackedPlayerMap.put(entityplayer, true); // PaperBukkit
+                    entityplayer.khopeTrackedEntries.add(this); // KHopeSpigot - 0163 reverse visibility index
                     Packet packet = this.c();
 
                     entityplayer.playerConnection.sendPacket(packet);
@@ -428,6 +431,7 @@ public class EntityTrackerEntry {
                 }
             } else if (this.trackedPlayers.remove(entityplayer)) {
                 // KHopeSpigot - 0162 avoid contains()+remove() double hash lookup
+                entityplayer.khopeTrackedEntries.remove(this); // KHopeSpigot - 0163
                 entityplayer.d(this.tracker);
             }
 
@@ -568,6 +572,7 @@ public class EntityTrackerEntry {
         org.spigotmc.AsyncCatcher.catchOp( "player tracker clear"); // Spigot
         if (this.trackedPlayers.remove(entityplayer)) {
             // KHopeSpigot - 0162 avoid contains()+remove() double hash lookup
+            entityplayer.khopeTrackedEntries.remove(this); // KHopeSpigot - 0163
             entityplayer.d(this.tracker);
         }
 
