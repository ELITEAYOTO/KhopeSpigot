+                    && MinecraftServer.getServer().isMainThread()) {
+                this.queueKhopeChunkGeneration(i, j, runnable);
+                return null;
+            }
+            // KHopeSpigot end
+
             chunk = originalGetChunkAt(i, j);
         }
 
@@ -174,6 +219,148 @@ public class ChunkProviderServer implements IChunkProvider {
 
         return chunk;
     }
+
+    // KHopeSpigot start - 0150 budgeted player chunk generation
+    private void queueKhopeChunkGeneration(int x, int z, Runnable callback) {
+        final long key = LongHash.toLong(x, z);
+
+        if (this.chunks.get(key) != null) {
+            callback.run();
+            return;
+        }
+
+        final Long boxedKey = Long.valueOf(key);
+        KhopePendingChunkGeneration pending = this.khopePendingChunkGenerationByKey.get(boxedKey);
+        if (pending == null) {
+            pending = new KhopePendingChunkGeneration(key, x, z);
+            this.khopePendingChunkGenerationByKey.put(boxedKey, pending);
+            this.khopePendingChunkGenerations.add(pending);
+        }
+
+        if (!pending.callbacks.contains(callback)) {
+            pending.callbacks.add(callback);
+        }
+    }
+
+    public void dropKhopeQueuedChunkGeneration(int x, int z, Runnable callback) {
+        if (callback == null) {
+            return;
+        }
+
+        final Long key = Long.valueOf(LongHash.toLong(x, z));
+        final KhopePendingChunkGeneration pending = this.khopePendingChunkGenerationByKey.get(key);
+        if (pending == null) {
+            return;
+        }
+
+        pending.callbacks.remove(callback);
+        if (pending.callbacks.isEmpty()) {
+            this.khopePendingChunkGenerationByKey.remove(key);
+            pending.cancelled = true;
+        }
+    }
+
+    public void processKhopeDeferredChunkGenerations() {
+        if (this.khopePendingChunkGenerations.isEmpty()) {
+            return;
+        }
+
+        final com.hpfxd.pandaspigot.config.PandaSpigotWorldConfig config =
+                this.world.pandaSpigotConfig;
+        final boolean budgeting = config.budgetPlayerChunkGeneration;
+
+        // If the option is disabled/reloaded while requests are already
+        // pending, finish those existing requests without a budget instead of
+        // leaving PlayerChunk callbacks stranded forever.
+        final int maxPerTick = budgeting ? config.playerChunkGenerationMaxPerTick : 0;
+        final long budgetNanos = !budgeting || config.playerChunkGenerationBudgetMs <= 0.0D
+                ? Long.MAX_VALUE
+                : (long) (config.playerChunkGenerationBudgetMs * 1_000_000.0D);
+
+        final long startNanos = System.nanoTime();
+        int generated = 0;
+        boolean budgetHit = false;
+
+        while (true) {
+            KhopePendingChunkGeneration pending = this.khopePendingChunkGenerations.peek();
+
+            // Discard stale/cancelled queue nodes in O(1) from the head.
+            while (pending != null
+                    && (pending.cancelled
+                    || this.khopePendingChunkGenerationByKey.get(Long.valueOf(pending.key)) != pending)) {
+                this.khopePendingChunkGenerations.poll();
+                pending = this.khopePendingChunkGenerations.peek();
+            }
+
+            if (pending == null) {
+                break;
+            }
+
+            if (maxPerTick > 0 && generated >= maxPerTick) {
+                budgetHit = true;
+                break;
+            }
+
+            // Always allow at least one generation so an extremely small time
+            // budget cannot deadlock the queue.
+            if (generated > 0
+                    && budgetNanos != Long.MAX_VALUE
+                    && System.nanoTime() - startNanos >= budgetNanos) {
+                budgetHit = true;
+                break;
+            }
+
+            this.khopePendingChunkGenerations.poll();
+            this.khopePendingChunkGenerationByKey.remove(Long.valueOf(pending.key));
+
+            // Another path may have loaded/generated the chunk while this
+            // request was waiting. In that case only complete the callbacks.
+            if (this.chunks.get(pending.key) == null) {
+                this.originalGetChunkAt(pending.x, pending.z);
+                ++generated;
+            }
+
+            for (int callbackIndex = 0; callbackIndex < pending.callbacks.size(); ++callbackIndex) {
+                try {
+                    pending.callbacks.get(callbackIndex).run();
+                } catch (Throwable throwable) {
+                    ChunkProviderServer.b.error(
+                            "Exception completing deferred chunk generation callback at "
+                                    + pending.x + "," + pending.z,
+                            throwable);
+                }
+            }
+        }
+
+        final KhopePendingChunkGeneration oldest = this.peekKhopePendingChunkGeneration();
+        final long oldestAgeNanos = oldest == null
+                ? 0L
+                : Math.max(0L, System.nanoTime() - oldest.queuedNanos);
+
+        com.hpfxd.pandaspigot.util.KhopePerformanceDiagnostics.recordDeferredChunkGenerationBudget(
+                generated,
+                this.khopePendingChunkGenerationByKey.size(),
+                System.nanoTime() - startNanos,
+                budgetHit,
+                oldestAgeNanos);
+    }
+
+    private KhopePendingChunkGeneration peekKhopePendingChunkGeneration() {
+        KhopePendingChunkGeneration pending = this.khopePendingChunkGenerations.peek();
+        while (pending != null
+                && (pending.cancelled
+                || this.khopePendingChunkGenerationByKey.get(Long.valueOf(pending.key)) != pending)) {
+            this.khopePendingChunkGenerations.poll();
+            pending = this.khopePendingChunkGenerations.peek();
+        }
+        return pending;
+    }
+
+    public int getKhopePendingChunkGenerationCount() {
+        return this.khopePendingChunkGenerationByKey.size();
+    }
+    // KHopeSpigot end
+
     public Chunk originalGetChunkAt(int i, int j) {
         long key = LongHash.toLong(i, j); // PandaSpigot - Only create key once
         this.unloadQueue.remove(i, j);
