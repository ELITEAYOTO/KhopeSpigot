+    public static void recordDeferredChunkGenerationBudget(
+            int generated,
+            int pending,
+            long workNanos,
+            boolean budgetHit,
+            long oldestAgeNanos) {
+        if (!isSlowPathCaptureEnabled()) {
+            return;
+        }
+
+        ++deferredGenerationTicks;
+        deferredGeneratedChunks += generated;
+        deferredGenerationWorkNanos += Math.max(0L, workNanos);
+
+        if (workNanos > deferredGenerationMaxTickNanos) {
+            deferredGenerationMaxTickNanos = workNanos;
+        }
+        if (budgetHit) {
+            ++deferredGenerationBudgetHits;
+        }
+        if (pending > deferredGenerationMaxPending) {
+            deferredGenerationMaxPending = pending;
+        }
+        if (oldestAgeNanos > deferredGenerationMaxOldestAgeNanos) {
+            deferredGenerationMaxOldestAgeNanos = oldestAgeNanos;
+        }
+    }
+
     public static void recordSection(int section, long nanos) {
         if (!detailThisTick
                 || section < 0
