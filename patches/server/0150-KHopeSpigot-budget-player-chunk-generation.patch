@@ -37,6 +41,38 @@ public class ChunkProviderServer implements IChunkProvider {
     public LongObjectHashMap<Chunk> chunks = new LongObjectHashMap<Chunk>();
     public WorldServer world;
 
+    // KHopeSpigot start - 0150 budgeted player chunk generation
+    //
+    // getChunkAt(x, z, Runnable) is the async-compatible path used by
+    // PlayerChunkMap. Existing chunks can be read through ChunkIOExecutor, but
+    // previously brand-new chunks fell through to originalGetChunkAt() and
+    // generated synchronously in the caller's tick. A teleport at view-distance
+    // 12 can therefore request roughly 625 chunks at once.
+    //
+    // Keep generation on the primary thread for 1.8.8 generator/populator
+    // compatibility, but defer and deduplicate new terrain requests so only a
+    // bounded amount is generated each world tick.
+    private final Queue<KhopePendingChunkGeneration> khopePendingChunkGenerations =
+            new ArrayDeque<KhopePendingChunkGeneration>();
+    private final Map<Long, KhopePendingChunkGeneration> khopePendingChunkGenerationByKey =
+            new HashMap<Long, KhopePendingChunkGeneration>();
+
+    private static final class KhopePendingChunkGeneration {
+        private final long key;
+        private final int x;
+        private final int z;
+        private final long queuedNanos = System.nanoTime();
+        private final List<Runnable> callbacks = new ArrayList<Runnable>(2);
+        private boolean cancelled;
+
+        private KhopePendingChunkGeneration(long key, int x, int z) {
+            this.key = key;
+            this.x = x;
+            this.z = z;
+        }
+    }
+    // KHopeSpigot end
+
     public ChunkProviderServer(WorldServer worldserver, IChunkLoader ichunkloader, IChunkProvider ichunkprovider) {
         this.emptyChunk = new EmptyChunk(worldserver, Integer.MIN_VALUE, Integer.MIN_VALUE); // PandaSpigot - Occasional Client Side Unloading of 0,0 chunk
         this.world = worldserver;
@@ -164,6 +200,15 @@ public class ChunkProviderServer implements IChunkProvider {
                 }
             }
         } else if (chunk == null) {
