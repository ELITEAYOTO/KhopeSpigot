From 759cbbc96efc3b46032385ae4f440304ad0737c6 Mon Sep 17 00:00:00 2001
From: Timothe <timothe.renou@gmail.com>
Date: Mon, 17 Aug 2026 16:30:13 +0200
Subject: [PATCH] KHopeSpigot: avoid entity slice iterator allocations

---
 src/main/java/net/minecraft/server/Chunk.java | 19 +++++++++++--------
 1 file changed, 11 insertions(+), 8 deletions(-)

diff --git a/src/main/java/net/minecraft/server/Chunk.java b/src/main/java/net/minecraft/server/Chunk.java
index 3cb8d9931..b13da5e84 100644
--- a/src/main/java/net/minecraft/server/Chunk.java
+++ b/src/main/java/net/minecraft/server/Chunk.java
@@ -989,8 +989,8 @@ public class Chunk {
         j = MathHelper.clamp(j, 0, this.entitySlices.length - 1);
 
         for (int k = i; k <= j; ++k) {
-            if (!this.entitySlices[k].isEmpty()) {
-                Iterator iterator = this.entitySlices[k].iterator();
+            final List<Entity> entitySlice = this.entitySlices[k];
+            if (!entitySlice.isEmpty()) {
                 // PaperSpigot start - Don't search for inventories if we have none, and that is all we want
                 /*
                  * We check if they want inventories by seeing if it is the static `IEntitySelector.c`
@@ -1000,8 +1000,9 @@ public class Chunk {
                  */
                 if (predicate == IEntitySelector.c && inventoryEntityCounts[k] <= 0) continue;
                 // PaperSpigot end
-                while (iterator.hasNext()) {
-                    Entity entity1 = (Entity) iterator.next();
+                // KHopeSpigot start - avoid UnsafeList iterator allocation in entity query hot path
+                for (int entityIndex = 0; entityIndex < entitySlice.size(); ++entityIndex) {
+                    Entity entity1 = entitySlice.get(entityIndex);
 
                     if (entity1.getBoundingBox().b(axisalignedbb) && entity1 != entity) {
                         if (predicate == null || predicate.apply(entity1)) {
@@ -1020,6 +1021,7 @@ public class Chunk {
                         }
                     }
                 }
+                // KHopeSpigot end
             }
         }
 
@@ -1044,15 +1046,16 @@ public class Chunk {
         // PaperSpigot end
         for (int k = i; k <= j; ++k) {
             if (counts != null && counts[k] <= 0) continue; // PaperSpigot - Don't check a chunk if it doesn't have the type we are looking for
-            Iterator iterator = this.entitySlices[k].iterator(); // Spigot
-
-            while (iterator.hasNext()) {
-                Entity entity = (Entity) iterator.next();
+            // KHopeSpigot start - avoid UnsafeList iterator allocation in typed entity query hot path
+            final List<Entity> entitySlice = this.entitySlices[k];
+            for (int entityIndex = 0; entityIndex < entitySlice.size(); ++entityIndex) {
+                Entity entity = entitySlice.get(entityIndex);
 
                 if (oclass.isInstance(entity) && entity.getBoundingBox().b(axisalignedbb) && (predicate == null || predicate.apply((T) entity))) { // CraftBukkit - fix decompile error // Spigot
                     list.add((T) entity); // Fix decompile error
                 }
             }
+            // KHopeSpigot end
         }
 
     }
