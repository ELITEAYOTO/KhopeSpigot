From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: KHopeSpigot <noreply@localhost>
Date: Tue, 28 Jul 2026 11:00:00 +0200
Subject: [PATCH] KHopeSpigot: fix save-all flush infinite loop

Stop draining the asynchronous chunk-save queue once it is empty. The
previous unconditional loop could pin the server thread forever after
/save-all flush or another synchronous region flush.
diff --git a/src/main/java/net/minecraft/server/ChunkRegionLoader.java b/src/main/java/net/minecraft/server/ChunkRegionLoader.java
--- a/src/main/java/net/minecraft/server/ChunkRegionLoader.java
+++ b/src/main/java/net/minecraft/server/ChunkRegionLoader.java
@@ -189,10 +189,8 @@ public class ChunkRegionLoader implements IChunkLoader, IAsyncChunkSaver {
         try {
             this.e = true;
 
-            while (true) {
-                if (this.c()) {
-                    continue;
-                }
+            while (this.c()) {
+                ;
             }
         } finally {
             this.e = false;
diff --git a/src/test/java/net/minecraft/server/ChunkRegionLoaderTest.java b/src/test/java/net/minecraft/server/ChunkRegionLoaderTest.java
new file mode 100644
--- /dev/null
+++ b/src/test/java/net/minecraft/server/ChunkRegionLoaderTest.java
@@ -0,0 +1,16 @@
+package net.minecraft.server;
+
+import java.io.File;
+import java.nio.file.Files;
+
+import org.junit.Test;
+
+public class ChunkRegionLoaderTest {
+
+    @Test(timeout = 1000L)
+    public void flushReturnsWhenNoChunkIsPending() throws Exception {
+        File regionDirectory = Files.createTempDirectory("chunk-region-loader-test").toFile();
+
+        new ChunkRegionLoader(regionDirectory).b();
+    }
+}
