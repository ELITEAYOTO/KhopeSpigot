From 7bb80fb4c6250487c1f6bc8dd81041657436d1b1 Mon Sep 17 00:00:00 2001
From: Volkaria <volkaria@local>
Date: Tue, 28 Jul 2026 14:00:00 +0200
Subject: [PATCH] KHopeSpigot serialize direct plugin class definition

JavaPluginLoader invokes PluginClassLoader.findClass(name, false) directly
when searching globally shared plugin classes. That path bypasses the
per-class loading lock normally acquired by ClassLoader.loadClass.

Concurrent lazy class loading could consequently define the same class twice
inside one plugin classloader. EssentialsX reproduced this on join with
OfflinePlayerStub. Acquire the standard per-name class-loading lock in the
direct overload as well.
---
 .../org/bukkit/plugin/java/PluginClassLoader.java  | 43 ++++++++++++----------
 1 file changed, 24 insertions(+), 19 deletions(-)

diff --git a/src/main/java/org/bukkit/plugin/java/PluginClassLoader.java b/src/main/java/org/bukkit/plugin/java/PluginClassLoader.java
index b2cbf9e4..0866456f 100644
--- a/src/main/java/org/bukkit/plugin/java/PluginClassLoader.java
+++ b/src/main/java/org/bukkit/plugin/java/PluginClassLoader.java
@@ -88,28 +88,35 @@ public final class PluginClassLoader extends URLClassLoader { // Spigot
     }
 
     Class<?> findClass(String name, boolean checkGlobal) throws ClassNotFoundException {
-        if (name.startsWith("org.bukkit.") || name.startsWith("net.minecraft.")) {
-            throw new ClassNotFoundException(name);
-        }
-        Class<?> result = classes.get(name);
-
-        if (result == null) {
-            if (checkGlobal) {
-                result = loader.getClassByName(name);
+        // JavaPluginLoader calls this overload directly while resolving shared
+        // plugin classes, bypassing ClassLoader#loadClass and therefore its
+        // per-name lock. Without the same lock here, two async plugin tasks can
+        // both reach URLClassLoader#defineClass for one name and one fails with
+        // "attempted duplicate class definition".
+        synchronized (getClassLoadingLock(name)) {
+            if (name.startsWith("org.bukkit.") || name.startsWith("net.minecraft.")) {
+                throw new ClassNotFoundException(name);
             }
+            Class<?> result = classes.get(name);
 
             if (result == null) {
-                result = super.findClass(name);
+                if (checkGlobal) {
+                    result = loader.getClassByName(name);
+                }
 
-                if (result != null) {
-                    loader.setClass(name, result);
+                if (result == null) {
+                    result = super.findClass(name);
+
+                    if (result != null) {
+                        loader.setClass(name, result);
+                    }
                 }
+
+                classes.put(name, result);
             }
 
-            classes.put(name, result);
+            return result;
         }
-
-        return result;
     }
 
     Set<String> getClasses() {
